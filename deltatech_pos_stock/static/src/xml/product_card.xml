<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="deltatech_pos_stock.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <!-- În 19.0 cardul nu mai are `div.product-information-tag`; badge-ul e poziționat absolut în `article`. -->
        <xpath expr="//div[hasclass('product-content')]" position="before">
            <div
                t-if="this.pos and this.pos.config and (this.pos.config.display_stock or this.pos.config.display_price) and this.props.product"
                class="product-stock-tag"
            >
                <div t-if="this.pos.config.display_price and this.formattedPrice" class="product-price-badge">
                    <t t-out="this.formattedPrice" />
                </div>
                <div
                    t-if="this.pos.config.display_stock and this.props.product.is_storable"
                    t-attf-class="product-qty {{ this.stockBadgeClass }}"
                >
                    <t t-out="this.stockQuantity" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
