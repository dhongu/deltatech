<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="deltatech_sale_stage.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="stage_route_id" />
            </xpath>
            <xpath expr="//field[@name='phase_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='phase_ids']" position="after">
                <field
                    name="phase_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    groups="deltatech_sale_stage_route.group_phase_admin"
                />
                <field
                    name="phase_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    readonly="1"
                    groups="!deltatech_sale_stage_route.group_phase_admin"
                />
            </xpath>
        </field>
    </record>

    <record id="view_order_kanban_stage" model="ir.ui.view">
        <field name="name">sale.order.kanban.stage</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="phase_id" quick_create="false">
                <field name="name" />
                <field name="partner_id" />
                <field name="amount_total" />
                <field name="phase_id" />
                <field name="currency_id" />
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                            </div>
                            <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" />
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="partner_id" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sale_order_kanban_stage" model="ir.actions.act_window">
        <field name="name">Sale Orders by Phase</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_order_kanban_stage" />
        <field name="context">{'default_group_by': 'phase_id'}</field>
    </record>

    <menuitem
        id="menu_sale_order_kanban_stage"
        name="Orders by Phase"
        action="action_sale_order_kanban_stage"
        parent="sale.sale_order_menu"
        sequence="20"
    />
</odoo>
