<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="phase_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    invisible="not sale_id"
                    readonly="1"
                />
                <field name="stage_route_id" invisible="not stage_route_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="phase_id" optional="show" />
                <field name="phase_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="stock_picking_kanban" model="ir.ui.view">
        <field name="name">stock.picking.kanban</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.stock_picking_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="phase_color" />
                <field name="next_phase_id" />
                <field name="next_phase_color" />
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <div
                    t-if="record.phase_id.raw_value"
                    class="o_tag d-inline-flex align-items-center rounded-pill px-2 py-0 fw-bold ms-1"
                    t-attf-class="o_tag_color_{{record.phase_color.raw_value || 0}}"
                >
                    <field name="phase_id" />
                </div>
                <div
                    t-if="record.next_phase_id.raw_value"
                    class="o_tag d-inline-flex align-items-center rounded-pill px-2 py-0 fw-bold ms-1 opacity-75"
                    t-attf-class="o_tag_color_{{record.next_phase_color.raw_value || 0}}"
                >
                    <i class="fa fa-long-arrow-right me-1" />
                    <field name="next_phase_id" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_barcode" model="ir.ui.view">
        <field name="name">stock.picking.form.view.barcode.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_barcode.stock_picking_barcode" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="phase_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="stock_picking_kanban_stage" model="ir.ui.view">
        <field name="name">stock.picking.kanban.stage</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="phase_id" quick_create="false">
                <field name="name" />
                <field name="partner_id" />
                <field name="origin" />
                <field name="phase_id" />
                <field name="phase_color" />
                <field name="next_phase_id" />
                <field name="next_phase_color" />
                <field name="state" />
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                            </div>
                            <field
                                name="state"
                                widget="badge"
                                decoration-success="state == 'done'"
                                decoration-info="state not in ('done', 'cancel', 'draft')"
                                decoration-muted="state == 'draft'"
                            />
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="origin" /></div>
                            <div><field name="partner_id" /></div>
                            <div class="mt-1">
                                <div
                                    t-if="record.phase_id.raw_value"
                                    class="o_tag d-inline-flex align-items-center rounded-pill px-2 py-0 fw-bold"
                                    t-attf-class="o_tag_color_{{record.phase_color.raw_value || 0}}"
                                >
                                    <field name="phase_id" />
                                </div>
                                <div
                                    t-if="record.next_phase_id.raw_value"
                                    class="o_tag d-inline-flex align-items-center rounded-pill px-2 py-0 fw-bold ms-1 opacity-75"
                                    t-attf-class="o_tag_color_{{record.next_phase_color.raw_value || 0}}"
                                >
                                    <i class="fa fa-long-arrow-right me-1" />
                                    <field name="next_phase_id" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_picking_kanban_stage" model="ir.actions.act_window">
        <field name="name">Pickings by Phase</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="stock_picking_kanban_stage" />
        <field name="context">{'default_group_by': 'phase_id'}</field>
    </record>

    <menuitem
        id="menu_picking_kanban_stage"
        name="Pickings by Phase"
        action="action_picking_kanban_stage"
        parent="stock.menu_stock_transfers"
        sequence="25"
    />

</odoo>
