<odoo>
    <record id="res_groups_privilege_kaizen" model="res.groups.privilege">
        <field name="name">Kaizen</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_kaizen_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_kaizen"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_kaizen_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_kaizen"/>
        <field name="implied_ids" eval="[(4, ref('group_kaizen_user'))]"/>
    </record>
</odoo>
