<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        if="base_unit_price"
        inherit_id="website_sale.base_unit_price"
        name="Base Unit Price without tax"
        customize_show="True"
        priority="100"
    >
        <xpath expr="//" position="inside">

                <t t-if="combination_info.get('base_unit_price_without_tax')">
                    <span>Base Unit Price without tax</span>
                    <span
                        class="oe_price"
                        style="white-space: nowrap;"
                        t-out="combination_info['base_unit_price_without_tax']"
                        t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                    />
                </t>
        </xpath>
    </template>


</odoo>
