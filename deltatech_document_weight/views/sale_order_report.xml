<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" priority="100">
        <xpath expr="//td[@name='td_product_name']//span[@t-field='line.label']" position="after">
            <t t-if="doc.company_id.document_weight_on_sale and line.product_id and not line.display_type">
                <t t-set="x_weights" t-value="line.product_id._get_document_weights(line.product_uom_qty, line.product_uom_id)"/>
                <t t-set="x_labels" t-value="doc._get_document_weight_labels()"/>
                <div t-if="x_weights['net'] or x_weights['gross'] or x_weights['volume']" class="text-muted small" name="document_weight_line">
                    Net weight: <span t-out="x_weights['net']" t-options="{'widget': 'float', 'decimal_precision': 'Stock Weight'}"/> <t t-out="x_labels['weight']"/><br/>
                    Gross weight: <span t-out="x_weights['gross']" t-options="{'widget': 'float', 'decimal_precision': 'Stock Weight'}"/> <t t-out="x_labels['weight']"/><br/>
                    Volume: <span t-out="x_weights['volume']" t-options="{'widget': 'float', 'decimal_precision': 'Volume'}"/> <t t-out="x_labels['volume']"/><br/>
                    <em>(estimated values)</em>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <t t-if="doc.company_id.document_weight_on_sale">
                <t t-set="x_totals" t-value="doc._get_document_weight_totals(lines_to_report)"/>
                <t t-set="x_labels" t-value="doc._get_document_weight_labels()"/>
                <div class="row" name="document_weight_totals" t-if="x_totals['net'] or x_totals['gross'] or x_totals['volume']">
                    <div class="col-12 text-muted small">
                        <strong>Total net weight:</strong> <span t-out="x_totals['net']" t-options="{'widget': 'float', 'decimal_precision': 'Stock Weight'}"/> <t t-out="x_labels['weight']"/> &#160;
                        <strong>Total gross weight:</strong> <span t-out="x_totals['gross']" t-options="{'widget': 'float', 'decimal_precision': 'Stock Weight'}"/> <t t-out="x_labels['weight']"/> &#160;
                        <strong>Total volume:</strong> <span t-out="x_totals['volume']" t-options="{'widget': 'float', 'decimal_precision': 'Volume'}"/> <t t-out="x_labels['volume']"/><br/>
                        <em>(estimated values)</em>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
