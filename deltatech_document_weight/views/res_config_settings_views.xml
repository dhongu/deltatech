<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_document_weight" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.document.weight</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Weights on documents" name="document_weight_setting_container">
                    <setting
                        id="document_weight_on_sale"
                        company_dependent="1"
                        help="Net weight, gross weight and volume under each product and in total on the quotation report"
                    >
                        <field name="document_weight_on_sale" />
                    </setting>
                    <setting
                        id="document_weight_on_invoice"
                        company_dependent="1"
                        help="Net weight, gross weight and volume under each product and in total on the customer invoice"
                    >
                        <field name="document_weight_on_invoice" />
                    </setting>
                    <setting
                        id="document_weight_propagate_variants"
                        help="Write the weight, the volume and the net weight of a template on all its variants, including the ones created on demand"
                    >
                        <field name="document_weight_propagate_variants" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
