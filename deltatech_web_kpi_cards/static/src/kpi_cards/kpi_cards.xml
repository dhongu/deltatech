<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="deltatech_web_kpi_cards.KpiCards">
        <div class="o_kpi_cards">
            <t t-foreach="props.cards" t-as="card" t-key="card.key">
                <button
                    type="button"
                    class="o_kpi_card btn bg-view text-start"
                    t-att-class="'o_kpi_card_' + toneOf(card) + (card.active ? ' active' : '') + (isZero(card) ? ' o_kpi_card_zero' : '')"
                    t-att-data-card="card.key"
                    t-att-title="card.title or card.label"
                    t-att-aria-pressed="card.active ? 'true' : 'false'"
                    t-on-click="() => this.onClick(card)"
                >
                    <span t-if="card.icon" class="o_kpi_card_icon" aria-hidden="true">
                        <i t-attf-class="fa {{ card.icon }}" />
                    </span>
                    <span class="o_kpi_card_body">
                        <span class="o_kpi_card_value">
                            <t t-if="card.amounts">
                                <t t-if="card.amounts.length">
                                    <span t-foreach="card.amounts" t-as="amount" t-key="amount_index" class="d-block" t-out="amount" />
                                </t>
                                <t t-else="">0</t>
                            </t>
                            <t t-else="" t-out="formatCount(card.count)" />
                        </span>
                        <span class="o_kpi_card_label" t-out="card.label" />
                        <span t-if="card.subtitle" class="o_kpi_card_label" t-out="card.subtitle" />
                        <span t-if="hasDelta(card)" class="o_kpi_card_delta" t-att-class="deltaClass(card)">
                            <i t-attf-class="fa {{ deltaIcon(card) }}" aria-hidden="true" />
                            <t t-out="deltaText(card)" />
                            <span t-if="card.deltaLabel" class="o_kpi_card_label" t-out="card.deltaLabel" />
                        </span>
                        <t t-if="hasProgress(card)">
                            <span class="o_kpi_card_progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                                t-att-aria-valuenow="progressWidth(card)">
                                <span class="o_kpi_card_progress_bar" t-att-style="'width: ' + progressWidth(card) + '%'" />
                            </span>
                            <span t-if="card.progressLabel" class="o_kpi_card_label" t-out="card.progressLabel" />
                        </t>
                        <svg t-if="sparkline(card)" class="o_kpi_card_spark" viewBox="0 0 100 28"
                            preserveAspectRatio="none" aria-hidden="true">
                            <polyline t-att-points="sparkline(card)" fill="none" stroke="currentColor"
                                stroke-width="1.5" vector-effect="non-scaling-stroke" />
                        </svg>
                    </span>
                </button>
            </t>
        </div>
    </t>

</templates>
