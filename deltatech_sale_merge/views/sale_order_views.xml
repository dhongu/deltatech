<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_sale_order_merge" model="ir.actions.server">
        <field name="name">Merge orders</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        <field name="state">code</field>
        <field name="code">action = records.action_merge_orders()</field>
    </record>

    <record id="view_order_form_merge" model="ir.ui.view">
        <field name="name">sale.order.form.merge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="merged_into_id" invisible="not merged_into_id" />
                <field name="merged_from_ids" widget="many2many_tags" invisible="not merged_from_ids" />
            </xpath>
        </field>
    </record>
</odoo>
