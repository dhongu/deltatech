<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="import_lines_mapping_company_rule" model="ir.rule">
        <field name="name">Import lines mapping: multi-company</field>
        <field name="model_id" ref="model_import_lines_mapping" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_lines_mapping_column_company_rule" model="ir.rule">
        <field name="name">Import lines mapping column: multi-company</field>
        <field name="model_id" ref="model_import_lines_mapping_column" />
        <field
            name="domain_force"
        >['|', ('mapping_id.company_id', '=', False), ('mapping_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
