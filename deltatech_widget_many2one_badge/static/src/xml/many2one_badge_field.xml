<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="deltatech_widget_many2one_badge.ColorPopover" owl="1">
        <div class="o_tag_popover m-2">
            <ColorList disableTransparent="true" onColorSelected="this.props.onColorSelected" />
        </div>
    </t>

    <t t-name="deltatech_widget_many2one_badge.Many2oneBadgeField" owl="1">
        <t t-if="this.props.readonly">
            <div t-if="this.value" class="d-flex align-items-center h-100">
                <span t-attf-class="badge rounded-pill o_tag o_tag_color_{{ this.colorIndex }}" style="font-size: 100%;">
                    <t t-out="this.displayName" />
                </span>
            </div>
        </t>
        <t t-else="">
            <div class="o_field_many2one_badge d-inline-flex flex-wrap gap-1 align-items-center o_tags_input o_input">
                <t t-if="this.value">
                    <span
                        t-attf-class="badge rounded-pill o_tag o_tag_color_{{ this.colorIndex }}"
                        style="font-size: 100%; cursor: pointer;"
                        t-on-click="this.onBadgeClick"
                    >
                        <t t-out="this.displayName" />
                        <a class="o_delete ms-1" title="Remove" t-on-click.stop="this.removeValue">&#215;</a>
                    </span>
                </t>
                <div t-if="!this.value" class="o_field_many2one_selection d-inline-flex flex-grow-1">
                    <Many2XAutocomplete
                        resModel="this.relation"
                        fieldString="this.props.string"
                        context="this.autocompleteContext"
                        getDomain="this.getDomain.bind(this)"
                        update.bind="this.update"
                        activeActions="this.activeActions"
                        value="''"
                        placeholder="this.props.placeholder || ''"
                    />
                </div>
            </div>
        </t>
    </t>
</templates>
