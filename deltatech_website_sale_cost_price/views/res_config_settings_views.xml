<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deltatech_website_sale_cost_price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='hide_add_to_cart_setting']" position="after">
                <setting
                    id="cost_price_sale_setting"
                    help="The cost price is kept with taxes included in the product"
                    invisible="not website_sale_prevent_zero_price_sale"
                >
                    <field name="cost_price_include_tax" />
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                class="o_light_label col-lg-3"
                                string="Cost Price Margin %"
                                for="cost_price_margin_percentage"
                            />
                            <field name="cost_price_margin_percentage" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
