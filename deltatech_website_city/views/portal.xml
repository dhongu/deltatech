<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_my_details_fields" inherit_id="portal.portal_my_details_fields" priority="100">
        <!-- Add IDs to existing country/state/city containers for JS toggling/reordering -->
        <xpath expr="//div[label[@for='country_id']]" position="attributes">
            <attribute name="id">div_country</attribute>
        </xpath>
        <xpath expr="//div[label[@for='state_id']]" position="attributes">
            <attribute name="id">div_state</attribute>
        </xpath>
        <xpath expr="//div[label[@for='city'] or input[@name='city']]" position="attributes">
            <attribute name="id">div_city</attribute>
        </xpath>

        <!-- Insert the city_id select just before the existing city text input -->
        <xpath expr="//div[label[@for='city'] or input[@name='city']]" position="before">
            <div id="div_city_id" t-attf-class="mb-3 #{error.get('city_id') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label label-optional" for="city_id">City</label>
                <select
                    id="city_id"
                    name="city_id"
                    t-attf-class="form-select #{error.get('city_id') and 'is-invalid' or ''}"
                    t-att-data-current_city_id="partner.city_id and partner.city_id.id or ''"
                >
                    <option value="">select...</option>
                    <t t-foreach="cities or []" t-as="city">
                        <option
                            t-att-value="city.id"
                            class="d-none"
                            t-att-data-state_id="city.state_id.id"
                            t-att-selected="city.id == partner.city_id.id"
                        >
                            <t t-esc="city.name" />
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </template>
</odoo>
