<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_groups_privilege_customer_segment" model="res.groups.privilege">
        <field name="name">Customer Portfolio</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_sales" />
    </record>

    <!--
        Own chain, not attached to the core sales groups: a salesperson does
        not see the portfolio analysis until the role is granted on him.
        The administrator gets the director role so that the menus are
        reachable on a new database.
    -->
    <record id="group_customer_segment_agent" model="res.groups">
        <field name="name">Own customers</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_segment" />
        <field name="comment">Sees the segment of the customers he is the salesperson of.</field>
    </record>

    <record id="group_customer_segment_director" model="res.groups">
        <field name="name">All customers</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_segment" />
        <field name="implied_ids" eval="[(4, ref('group_customer_segment_agent'))]" />
        <field name="comment">Sees every customer and edits the segmentation settings.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_customer_segment_director'))]" />
    </record>

    <record id="rule_customer_segment_company" model="ir.rule">
        <field name="name">Customer segment: multi-company</field>
        <field name="model_id" ref="model_deltatech_customer_segment" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>

    <record id="rule_customer_segment_config_company" model="ir.rule">
        <field name="name">Customer segment settings: multi-company</field>
        <field name="model_id" ref="model_deltatech_customer_segment_config" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>

    <record id="rule_customer_segment_agent" model="ir.rule">
        <field name="name">Customer segment: own customers</field>
        <field name="model_id" ref="model_deltatech_customer_segment" />
        <field name="domain_force">[('partner_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_customer_segment_agent'))]" />
    </record>

    <record id="rule_customer_segment_director" model="ir.rule">
        <field name="name">Customer segment: all customers</field>
        <field name="model_id" ref="model_deltatech_customer_segment" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_customer_segment_director'))]" />
    </record>

</odoo>
