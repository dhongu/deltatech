<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_disassembly_comp_rule" model="ir.rule">
        <field name="name">Disassembly report multi-company</field>
        <field name="model_id" ref="model_stock_disassembly" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="stock_disassembly_line_comp_rule" model="ir.rule">
        <field name="name">Disassembly report line multi-company</field>
        <field name="model_id" ref="model_stock_disassembly_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
