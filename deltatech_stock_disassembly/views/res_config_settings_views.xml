<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_stock_disassembly" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.stock.disassembly</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="inside">
                <setting
                    id="disassembly_allow_reclassification_setting"
                    string="Disassembly: reclassify goods and materials"
                    company_dependent="1"
                    help="Romanian chart of accounts: allow a disassembly report to turn goods (371) into materials (30x), or materials of one kind into another (30x), with a direct entry, as set by the accounting policy."
                >
                    <field name="disassembly_allow_reclassification" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
