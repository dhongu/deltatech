<odoo>

    <record id="view_stock_picking_activity_record_tree" model="ir.ui.view">
        <field name="name">stock.picking.activity.record.tree</field>
        <field name="model">stock.picking.activity.record</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="picking_id" />
                <field name="change_date" />
                <field name="state" />
                <field name="user_id" />
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_activity_record_pivot" model="ir.ui.view">
        <field name="name">stock.picking.activity.record.pivot</field>
        <field name="model">stock.picking.activity.record</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="user_id" type="row" />
                <field name="change_date" type="col" interval="day" />
                <field name="has_validated_count" type="measure" />
                <field name="chatter_message_count" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_stock_picking_activity_record_search" model="ir.ui.view">
        <field name="name">stock.picking.activity.record.search</field>
        <field name="model">stock.picking.activity.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="picking_id" />
                <field name="change_date" />
                <field name="state" />
                <field name="user_id" />
                <filter
                    string="This Month"
                    name="this_month"
                    domain="[('change_date', '&gt;=', context_today().strftime('%%Y-%%m-01'))]"
                />
                <filter
                    string="This Year"
                    name="this_year"
                    domain="[('change_date', '&gt;=', context_today().strftime('%%Y-01-01'))]"
                />
                <filter
                    string="Today"
                    name="today"
                    domain="[('change_date', '=', context_today().strftime('%%Y-%%m-%%d'))]"
                />
                <filter
                    string="Yesterday"
                    name="yesterday"
                    domain="[('change_date', '>=', (context_today() - relativedelta(days=1)).strftime('%%Y-%%m-%%d')), ('change_date', '&lt;', context_today().strftime('%%Y-%%m-%%d'))]"
                />

                <group expand="0" string="Group By">
                    <filter string="User" name="groupby_user" context="{'group_by':'user_id'}" />
                    <filter string="Date" name="groupby_date" context="{'group_by':'change_date'}" />
                    <filter string="State" name="groupby_state" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_stock_picking_activity_record_graph" model="ir.ui.view">
        <field name="name">stock.picking.activity.record.graph</field>
        <field name="model">stock.picking.activity.record</field>
        <field name="arch" type="xml">
            <graph>
                <field name="state" type="row" />
            </graph>
        </field>
    </record>

    <record id="view_stock_picking_activity_record_form" model="ir.ui.view">
        <field name="name">stock.picking.activity.record.form</field>
        <field name="model">stock.picking.activity.record</field>
        <field name="arch" type="xml">
            <form string="Activity Record">
                <sheet>
                    <group string="Basic Information">
                        <group>
                            <field name="picking_id" />
                            <field name="change_date" />
                        </group>
                        <group>
                            <field name="state" />
                            <field name="user_id" />
                        </group>
                    </group>
                    <group string="Tracked Events">
                        <group>
                            <field name="chatter_message" />
                            <field name="has_validated" />
                        </group>
                        <group>
                            <field name="entry_product_number" />
                            <field name="exit_product_number" />
                            <field name="internal_product_number" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Log">
                            <field name="activity_log" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_activity_record" model="ir.actions.act_window">
        <field name="name">Picking Activity Records</field>
        <field name="res_model">stock.picking.activity.record</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_stock_picking_activity_record_search" />
        <field name="context">{'search_default_this_month': 1}</field>
    </record>

    <menuitem
        id="menu_stock_picking_activity_record"
        name="Activity Records"
        parent="stock.menu_warehouse_report"
        action="action_stock_picking_activity_record"
        sequence="100"
    />
</odoo>
