<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pricelist_bulk_add_view_form" model="ir.ui.view">
        <field name="name">pricelist.bulk.add.form</field>
        <field name="model">pricelist.bulk.add</field>
        <field name="arch" type="xml">
            <form string="Add Pricelist Rules">
                <group>
                    <group name="target">
                        <field name="pricelist_id" options="{'no_create': True}" />
                        <field name="currency_id" invisible="1" />
                        <field name="applied_on" widget="radio" />
                        <field name="fill_categ_ids" widget="many2many_tags" invisible="applied_on == '2_product_category'" />
                    </group>
                    <group name="limits">
                        <field name="min_quantity" />
                        <field name="date_start" widget="daterange" options="{'end_date_field': 'date_end'}" string="Validity Period" />
                        <field name="date_end" invisible="1" />
                        <field name="existing_policy" widget="radio" />
                    </group>
                </group>
                <field name="product_tmpl_ids" invisible="applied_on != '1_product'" options="{'no_create': True}">
                    <list>
                        <field name="default_code" optional="show" />
                        <field name="name" />
                        <field name="categ_id" optional="show" />
                        <field name="list_price" optional="show" />
                        <field name="standard_price" optional="hide" />
                    </list>
                </field>
                <field name="product_ids" invisible="applied_on != '0_product_variant'" options="{'no_create': True}">
                    <list>
                        <field name="default_code" optional="show" />
                        <field name="display_name" string="Product Variant" />
                        <field name="categ_id" optional="show" />
                        <field name="lst_price" optional="show" />
                        <field name="standard_price" optional="hide" />
                    </list>
                </field>
                <field name="categ_ids" invisible="applied_on != '2_product_category'" options="{'no_create': True}">
                    <list>
                        <field name="display_name" string="Product Category" />
                    </list>
                </field>
                <group name="formula" string="Price Computation">
                    <group>
                        <field name="compute_price" widget="radio" options="{'horizontal': true}" />
                        <field name="fixed_price" invisible="compute_price != 'fixed'" />
                        <field name="percent_price" invisible="compute_price != 'percentage'" />
                        <field
                            name="base_pricelist_id"
                            string="On Pricelist"
                            placeholder="sales price"
                            invisible="compute_price != 'percentage'"
                        />
                        <field name="base" invisible="compute_price != 'formula'" />
                        <field
                            name="base_pricelist_id"
                            invisible="compute_price != 'formula' or base != 'pricelist'"
                            required="compute_price == 'formula' and base == 'pricelist'"
                        />
                        <field
                            name="price_discount"
                            string="Discount (%)"
                            invisible="compute_price != 'formula' or base == 'standard_price'"
                        />
                        <field
                            name="price_markup"
                            invisible="compute_price != 'formula' or base != 'standard_price'"
                        />
                        <field name="price_round" invisible="compute_price != 'formula'" />
                        <field name="price_surcharge" invisible="compute_price != 'formula'" />
                        <field name="price_min_margin" invisible="compute_price != 'formula'" />
                        <field name="price_max_margin" invisible="compute_price != 'formula'" />
                    </group>
                    <div class="alert alert-info" role="alert" invisible="compute_price != 'formula'">
                        <b>Tip: want to round at 9.99?</b>
                        <div>Round off to 10.00 and set an extra fee of -0.01.</div>
                    </div>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Add Rules" class="btn-primary" data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pricelist_bulk_add" model="ir.actions.act_window">
        <field name="name">Add Pricelist Rules</field>
        <field name="res_model">pricelist.bulk.add</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_pricelist_bulk_add_template" model="ir.actions.act_window">
        <field name="name">Add to Pricelist</field>
        <field name="res_model">pricelist.bulk.add</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[Command.link(ref('product.group_product_pricelist'))]" />
    </record>

    <record id="action_pricelist_bulk_add_variant" model="ir.actions.act_window">
        <field name="name">Add to Pricelist</field>
        <field name="res_model">pricelist.bulk.add</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[Command.link(ref('product.group_product_pricelist'))]" />
    </record>
</odoo>
