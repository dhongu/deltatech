<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The header cell bumps colspan_count like the core <th> do, so the section and combo
         rows (which span the whole table through colspan_count) include the image column
         without extra colspan arithmetic. The cells carry t-if directly (no wrapper <t>)
         so other modules can anchor on th_image / td_image and stay ordered relative to it. -->
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table/thead/tr/th[@name='th_description']" position="before">
            <th name="th_image" t-if="res_company.include_image_line">
                <t t-set="colspan_count" t-value="colspan_count + 1" />
            </th>
        </xpath>
        <td name="td_product_name" position="before">
            <td name="td_image" t-if="res_company.include_image_line">
                <img
                    t-if="line.product_id.image_256"
                    t-attf-src="#{image_data_uri(line.product_id.image_256)}"
                    alt="Image"
                    style="max-width:50px;"
                />
            </td>
        </td>
        <xpath expr="//td[@name='td_section_group_name']" position="before">
            <td t-if="res_company.include_image_line" />
        </xpath>
    </template>
</odoo>
