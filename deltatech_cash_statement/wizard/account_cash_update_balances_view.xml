<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_cash_update_balances_form" model="ir.ui.view">
        <field name="name">Cash Update Balances</field>
        <field name="model">account.cash.update.balances</field>
        <field name="arch" type="xml">
            <form string="Cash Update Balances">
                <field name="statement_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <group>
                    <field name="mode" widget="radio" />
                </group>
                <group>
                    <group>
                        <field name="journal_id" />
                        <field name="balance_start" />
                        <field name="accounting_balance" />
                    </group>
                    <group invisible="mode != 'difference'">
                        <field name="counted_balance" />
                        <field name="difference" />
                    </group>
                </group>
                <group invisible="mode != 'difference'">
                    <field name="date" required="mode == 'difference'" />
                    <field name="counterpart_account_id" required="mode == 'difference' and difference != 0" />
                    <field name="partner_required" invisible="1" />
                    <field name="partner_id" required="mode == 'difference' and partner_required" />
                    <field name="label" />
                </group>
                <div class="text-muted" invisible="mode != 'align'">
                    The declared balances of the selected statements are aligned with the cash account.
                    No journal entry is created: a real difference between the counted cash and the
                    accounting balance must be registered as a cash difference.
                </div>
                <footer>
                    <button name="do_update_balance" string="Apply" type="object" class="oe_highlight" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_cash_update_balances" model="ir.actions.act_window">
        <field name="name">Cash Update Balances</field>
        <field name="res_model">account.cash.update.balances</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_bank_statement" />
        <field name="binding_view_types">list</field>
    </record>

</odoo>
