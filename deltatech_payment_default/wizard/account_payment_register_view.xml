<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form.default</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="can_set_as_default" invisible="1" />
                <field name="set_as_default" invisible="not can_set_as_default" />
            </field>
        </field>
    </record>
</odoo>
