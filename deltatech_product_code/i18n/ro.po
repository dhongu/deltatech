msgstr "Prefix de companie GS1"

#. module: deltatech_product_code
#: model:ir.model.fields,help:deltatech_product_code.field_product_category__gs1_company_prefix
msgid ""
"Company prefix received from GS1 (e.g. 594xxxx). The GTIN-13 codes are "
"allocated in its range."
msgstr ""
"Prefixul de companie primit de la GS1 (de ex. 594xxxx). Codurile GTIN-13 se "
"alocă în plaja lui."

#. module: deltatech_product_code
