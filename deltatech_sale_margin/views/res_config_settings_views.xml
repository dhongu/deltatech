<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.sale.margin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting
                    string="Selling below cost"
                    help="How the system reacts when a line falls below the purchase price or below the margin limit."
                >
                    <field name="sale_margin_check_mode" class="o_light_label" />
                    <div class="mt-2" invisible="sale_margin_check_mode == 'off'">
                        <label for="sale_margin_limit" class="o_light_label me-2" />
                        <field name="sale_margin_limit" class="oe_inline" />
                        <span class="ms-1">%</span>
                    </div>
                    <div class="mt-2" invisible="sale_margin_check_mode != 'block'">
                        <field name="sale_margin_limit_check_validate" class="oe_inline" />
                        <label for="sale_margin_limit_check_validate" class="o_light_label" />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
