<?xml version="1.0" ?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <!-- Odoo 20: product_id / name / label sunt grupate in coloana product_and_description -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']" position="after">
                <field name="alternative_code" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
