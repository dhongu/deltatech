<?xml version="1.0" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.move.alternative</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <!-- Odoo 20: product_id si description_picking sunt grupate intr-un <column> -->
            <xpath expr="//field[@name='move_ids']/list/column[field[@name='product_id']]" position="after">
                <field name="alternative_code" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
