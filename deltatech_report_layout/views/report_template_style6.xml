<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="external_layout_style6">
        <div t-attf-class="o_company_#{company.id}_layout header o_header_style6">
            <div class="o_style6_row d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="o_style6_logo me-3"><img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo" /></div>
                    <h3 class="m-0" t-out="layout_document_title or 'Document'" />
                </div>
                <div class="o_style6_company text-end"><t t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}' /></t>
                <t t-else=""><span t-field="company.company_details" /></t>
                <div t-if="forced_vat"><t t-out="company.country_id.vat_label or 'Tax ID'">Tax ID</t>: <span t-out="forced_vat" /></div></div>
            </div>
        </div>
        <div
            t-attf-class="o_company_#{company.id}_layout article o_report_layout_style6 o_table_style6 o_snail_mail"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')"
        >
            <t t-call="web.address_layout" />
            <t t-out="0" />
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout o_footer_style6 {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content border-top pt-2 text-center">
                <div t-field="company.report_footer" />
                <div t-if="report_type == 'pdf'" class="text-muted">Page <span class="page" /> / <span class="topage" /></div>
            </div>
        </div>
    </template>

    <template id="external_layout_style6_css" inherit_id="web.styles_company_report">
        <xpath expr="//t[contains(@t-elif, 'web.external_layout_center')]" position="before">
            <t t-elif="layout == 'deltatech_report_layout.external_layout_style6'">
                &amp;.o_report_layout_style6 {
                    thead th { border-bottom: 1px solid <t t-out='primary' />; color: <t t-out='primary' />; }
                    #total .o_total td { border-top: 1px solid <t t-out='primary' />; }
                }
                &amp;.o_header_style6 h3 { color: <t t-out='primary' />; }
            </t>
        </xpath>
    </template>
</odoo>
