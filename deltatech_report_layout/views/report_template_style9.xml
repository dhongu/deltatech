<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Card: logo and company details on the left, large title on the right, a rule in the primary
        color under the header, the recipient address in a bordered box with rounded corners, tables
        without filled areas (toner friendly) and a footer with the document number and the page.
    -->
    <template id="external_layout_style9">
        <div t-attf-class="o_company_#{company.id}_layout header o_header_style9">
            <div class="row">
                <div class="col-6">
                    <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo" />
                    <div class="o_style9_company">
                        <t t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}' /></t>
                        <t t-else=""><span t-field="company.company_details" /></t>
                        <div t-if="forced_vat"><t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>: <span t-esc="forced_vat" /></div>
                    </div>
                </div>
                <div class="col-6 text-end">
                    <h2 class="o_style9_title" t-out="layout_document_title or 'Document'" />
                </div>
            </div>
            <div class="o_style9_rule" />
        </div>

        <t
            t-set="layout_background_url"
            t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''"
        />
        <div
            t-attf-class="o_company_#{company.id}_layout article o_report_layout_style9 o_table_style9 o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
            t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')"
        >
            <t t-call="web.address_layout" />
            <t t-out="0" />
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout o_footer_style9 {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content row">
                <div class="col-8">
                    <div t-field="company.report_footer" />
                </div>
                <div class="col-4 text-end">
                    <div t-if="report_type == 'pdf' and o and 'name' in o._fields and o.name" class="text-muted" t-out="str(o.name)" />
                    <strong t-if="report_type == 'pdf'">Page <span class="page" /> / <span class="topage" /></strong>
                </div>
            </div>
        </div>
    </template>

    <template id="external_layout_style9_css" inherit_id="web.styles_company_report">
        <xpath expr="//t[@t-elif]" position="before">
            <t t-elif="layout == 'deltatech_report_layout.external_layout_style9'">
                &amp;.o_header_style9 {
                    .o_style9_title { color: <t t-esc='primary' />; }
                    .o_style9_rule { border-top-color: <t t-esc='primary' />; }
                }
                &amp;.o_report_layout_style9 {
                    thead th { color: <t t-esc='secondary' />; }
                    #informations strong { color: <t t-esc='secondary' />; }
                    #total .o_total td { border-top: 2px solid <t t-esc='primary' />; }
                }
            </t>
        </xpath>
    </template>
</odoo>
