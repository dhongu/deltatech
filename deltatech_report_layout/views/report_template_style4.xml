<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="external_layout_style4">
        <div t-attf-class="o_company_#{company.id}_layout header o_header_style4">
            <div class="d-flex justify-content-between align-items-start">
                <div><img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo" /></div>
                <div class="text-end">
                    <h2 class="o_style4_title m-0" t-out="layout_document_title or 'Document'" />
                    <div class="o_style4_company small text-muted mt-2"><t t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}' /></t>
                <t t-else=""><span t-field="company.company_details" /></t>
                <div t-if="forced_vat"><t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>: <span t-esc="forced_vat" /></div></div>
                </div>
            </div>
        </div>

        <t
            t-set="layout_background_url"
            t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''"
        />
        <div
            t-attf-class="o_company_#{company.id}_layout article o_report_layout_style4 o_table_style4 o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
            t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')"
        >
            <t t-call="web.address_layout" />
            <h2 t-if="False" t-out="layout_document_title" />
            <t t-out="0" />
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout o_footer_style4 {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content border-top pt-2 text-center">
                <div t-field="company.report_footer" />
                <div t-if="report_type == 'pdf'" class="text-muted">Page <span class="page" /> / <span class="topage" /></div>
            </div>
        </div>
    </template>

    <template id="external_layout_style4_css" inherit_id="web.styles_company_report">
        <xpath expr="//t[@t-elif]" position="before">
            <t t-elif="layout == 'deltatech_report_layout.external_layout_style4'">
                &amp;.o_report_layout_style4 {
                    #informations { position: relative; }
                    #informations::after { content: ''; position: absolute; left: 16px; right: 16px; bottom: 0; border-bottom: 1px solid <t t-esc='secondary' />; }
                    thead th, #total .o_total td {
                        background-color: <t t-esc='primary' />;
                        color: preview-color-contrast(<t t-esc='primary' />);
                        strong { color: preview-color-contrast(<t t-esc='primary' />); }
                    }
                }
                &amp;.o_header_style4 .o_style4_title { color: <t t-esc='primary' />; }
            </t>
        </xpath>
    </template>
</odoo>
