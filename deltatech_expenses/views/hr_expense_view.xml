<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_expense_view_form_deduction" model="ir.ui.view">
        <field name="name">hr.expense.view.form.deduction</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <!-- Banner informativ când cheltuiala este decontată prin Decont -->
            <div name="warning_duplicate_receipt_expense" position="before">
                <div class="alert alert-info" role="alert" invisible="not expenses_deduction_id">
                    Această cheltuială este preluată într-un
                    <field name="expenses_deduction_id" readonly="1" nolabel="1" class="oe_inline" />
                    și se contabilizează acolo; postarea standard este dezactivată.
                </div>
            </div>
            <!-- Ascundem butoanele de postare standard când cheltuiala e legată de decont -->
            <xpath expr="//button[@name='action_post'][hasclass('o_expense_post_highlight')]" position="attributes">
                <attribute name="invisible">nb_attachment == 0 or state != 'approved' or expenses_deduction_id</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][hasclass('o_expense_post')]" position="attributes">
                <attribute name="invisible">nb_attachment &gt;= 1 or state != 'approved' or expenses_deduction_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
