<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_form_deduction" model="ir.ui.view">
        <field name="name">hr.employee.view.form.deduction</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_expenses_deductions"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    groups="deltatech_expenses.group_expenses_user,deltatech_expenses.group_expenses_approver,deltatech_expenses.group_expenses_accounting"
                >
                    <field name="expenses_deduction_count" widget="statinfo" string="Deconturi" />
                </button>
            </div>
        </field>
    </record>
</odoo>
