<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="privilege_agreement" model="res.groups.privilege">
        <field name="name">Agreements</field>
        <field name="category_id" ref="base.module_category_services" />
    </record>

    <!-- general.agreement.company_id is required: a user only sees the agreements of the allowed companies -->
    <record id="rule_general_agreement_company" model="ir.rule">
        <field name="name">General agreement: multi-company</field>
        <field name="model_id" ref="model_general_agreement" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <data noupdate="1">
        <record id="group_agreement_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_agreement" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>
        <record id="group_agreement_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_agreement" />
            <field name="implied_ids" eval="[(4, ref('group_agreement_user'))]" />
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
    </data>
</odoo>
