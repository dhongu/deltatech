<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_tree_valuation_active" model="ir.ui.view">
        <field name="name">stock.move.list.valuation.active</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="l10n_ro_valuation_active"
                    optional="hide"
                    widget="boolean_toggle"
                    groups="stock.group_stock_manager"
                />
            </field>
        </field>
    </record>
    <record id="view_move_search_valuation_active" model="ir.ui.view">
        <field name="name">stock.move.search.valuation.active</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search" />
        <field name="arch" type="xml">
            <filter name="inventory" position="after">
                <separator />
                <filter
                    name="valuation_closed"
                    string="Closed"
                    domain="[('l10n_ro_valuation_active', '=', False)]"
                    groups="stock.group_stock_manager"
                />
            </filter>
        </field>
    </record>
</odoo>
