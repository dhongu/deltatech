<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ledger_tree" model="ir.ui.view">
        <field name="name">ledger.tree</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'canceled'" decoration-info="state == 'reserved'" default_order="name desc">
                <field name="name" />
                <field name="record_date" />
                <field name="record_type" widget="badge" decoration-info="record_type == 'entry'" decoration-warning="record_type == 'exit'" />
                <field name="document_number" />
                <field name="contact_id" optional="show" />
                <field name="place_of_origin" optional="show" />
                <field name="record_short_description" optional="show" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'reserved'" decoration-danger="state == 'canceled'" />
            </list>
        </field>
    </record>

    <record id="view_ledger_form" model="ir.ui.view">
        <field name="name">ledger.form</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <form string="Ledger">
                <header>
                    <button name="action_confirm" string="Register" type="object" class="oe_highlight" invisible="state != 'reserved' or not id" />
                    <button name="action_cancel_wizard" string="Cancel" type="object" invisible="state not in ('reserved', 'active')" />
                    <button
                        name="action_reactivate"
                        string="Reactivate"
                        type="object"
                        invisible="state != 'canceled'"
                        groups="deltatech_ledger.group_ledger_manager"
                        confirm="Reactivate this record?"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="reserved,active,canceled" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Canceled" bg_color="text-bg-danger" invisible="state != 'canceled'" />
                    <field name="has_duplicate" invisible="1" />
                    <field name="sequence_year" invisible="1" />
                    <div class="alert alert-warning" role="alert" invisible="not has_duplicate">
                        A record with the same type, document number and contact already exists.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'reserved' or not id">
                        This number is reserved. Its date can be set between
                        <field name="date_min" class="oe_inline fw-bold" readonly="1" />
                        and
                        <field name="date_max" class="oe_inline fw-bold" readonly="1" />,
                        the dates of the previous and of the next number.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'canceled' or not cancel_reason">
                        Canceled: <field name="cancel_reason" class="oe_inline" readonly="1" />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="record_type" widget="radio" options="{'horizontal': true}" readonly="state == 'canceled'" />
                            <field name="record_date" required="state == 'active'" readonly="state == 'canceled'" />
                            <field name="document_number" readonly="state == 'canceled'" />
                        </group>
                        <group>
                            <field name="contact_id" readonly="state == 'canceled'" />
                            <field name="place_of_origin" readonly="state == 'canceled'" />
                            <field name="company_id" groups="base.group_multi_company" readonly="id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="record_short_description" readonly="state == 'canceled'" placeholder="Short description of the document..." />
                        </page>
                        <page string="Links" name="links">
                            <field name="link_ids" readonly="state == 'canceled'">
                                <list editable="bottom">
                                    <field name="link_type" />
                                    <field name="reference" invisible="link_type != 'record'" required="link_type == 'record'" />
                                    <field name="url" widget="url" invisible="link_type != 'url'" required="link_type == 'url'" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_ledger_kanban" model="ir.ui.view">
        <field name="name">ledger.kanban</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="0">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-5" />
                            <field name="record_type" widget="badge" decoration-info="record_type == 'entry'" decoration-warning="record_type == 'exit'" />
                        </div>
                        <field name="record_date" />
                        <field name="document_number" />
                        <field name="contact_id" class="text-truncate" />
                        <field name="record_short_description" class="text-muted text-truncate" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ledger_calendar" model="ir.ui.view">
        <field name="name">ledger.calendar</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <calendar date_start="record_date" color="record_type" mode="month" quick_create="0" event_open_popup="true">
                <field name="record_type" />
                <field name="document_number" />
                <field name="contact_id" />
            </calendar>
        </field>
    </record>

    <record id="view_ledger_pivot" model="ir.ui.view">
        <field name="name">ledger.pivot</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <pivot string="Ledger">
                <field name="record_date" interval="month" type="row" />
                <field name="record_type" type="col" />
            </pivot>
        </field>
    </record>

    <record id="view_ledger_graph" model="ir.ui.view">
        <field name="name">ledger.graph</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <graph string="Ledger" type="bar" stacked="0">
                <field name="record_date" interval="month" />
                <field name="record_type" />
            </graph>
        </field>
    </record>

    <record id="view_ledger_search" model="ir.ui.view">
        <field name="name">ledger.search</field>
        <field name="model">ledger.ledger</field>
        <field name="arch" type="xml">
            <search string="Ledger">
                <field name="name" />
                <field name="document_number" />
                <field name="contact_id" />
                <field name="place_of_origin" />
                <field name="record_short_description" />
                <field name="record_date" />
                <filter string="Reserved" name="filter_reserved" domain="[('state', '=', 'reserved')]" />
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]" />
                <filter string="Canceled" name="filter_canceled" domain="[('state', '=', 'canceled')]" />
                <separator />
                <filter string="Entry" name="filter_entry" domain="[('record_type', '=', 'entry')]" />
                <filter string="Exit" name="filter_exit" domain="[('record_type', '=', 'exit')]" />
                <separator />
                <filter string="Date" name="filter_record_date" date="record_date" />
                <group>
                    <filter string="Record Type" name="groupby_record_type" context="{'group_by': 'record_type'}" />
                    <filter string="Contact" name="groupby_contact" context="{'group_by': 'contact_id'}" />
                    <filter string="Record Date" name="groupby_record_date" context="{'group_by': 'record_date:month'}" />
                    <filter string="State" name="groupby_state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ledger_model" model="ir.actions.act_window">
        <field name="name">Ledger</field>
        <field name="res_model">ledger.ledger</field>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first document</p>
            <p>Record the entry and exit documents here. Each record gets a unique number from the register sequence.</p>
        </field>
    </record>

    <record id="action_ledger_reserve" model="ir.actions.act_window">
        <field name="name">Reserve a Number</field>
        <field name="res_model">ledger.ledger</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_state': 'reserved'}</field>
    </record>

    <menuitem id="menu_ledger_root" name="Ledger" sequence="50" web_icon="deltatech_ledger,static/description/icon.png" />
    <menuitem id="menu_ledger_model" name="Records" parent="menu_ledger_root" action="action_ledger_model" sequence="10" />
    <menuitem id="menu_ledger_reserve" name="Reserve a Number" parent="menu_ledger_root" action="action_ledger_reserve" sequence="20" />
</odoo>
