<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- One numbering for entries and exits, restarted every year. No-gap: a number is never lost on rollback. -->
    <record id="ledger_sequence" model="ir.sequence">
        <field name="name">Ledger Sequence</field>
        <field name="code">ledger.ledger</field>
        <field name="prefix">%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True" />
    </record>
</odoo>
