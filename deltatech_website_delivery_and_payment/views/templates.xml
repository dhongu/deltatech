<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="payment_delivery_methods" inherit_id="website_sale.payment_delivery_methods">
        <xpath expr="//input[@name='delivery_type']" position="before">
            <span t-if="delivery.logo">
              <img
                    t-att-src="image_data_uri(delivery.logo)"
                    class="img o_image_64_max rounded"
                    t-att-alt="delivery.name"
                />
            </span>
        </xpath>
    </template>

    <template id="checkout_delivery" inherit_id="website_sale.payment_delivery_methods">
        <xpath expr="//input[@name='delivery_type']" position="attributes">
            <attribute name="t-att-data-acquirer-allowed-ids">delivery.acquirer_allowed_ids.ids</attribute>
        </xpath>
    </template>


    <template id="confirmation" inherit_id="website_sale.confirmation">
        <xpath expr="//t[@t-set='tx_sudo']" position="after">
            <t t-if="tx_sudo.state == 'authorized'">
                <div  class="d-flex justify-content-between align-items-center">
                    <h3>Thank you for your order.</h3>
                    <a role="button" class="d-none d-md-inline-block btn btn-primary ms-auto" href="/shop/print" target="_blank" aria-label="Print" title="Print"><i class="fa fa-print me-2"></i>Print</a>
                </div>
                <div class="mb-4">
                    <h5>
                        <em>
                            <span>Order</span>
                            <span t-field="order.name" />
                                <i class="fa fa-stamp-circle ms-1"/>
                        </em>
                    </h5>
                </div>
            </t>
        </xpath>
    </template>

