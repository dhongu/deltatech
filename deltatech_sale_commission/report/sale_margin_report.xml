<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sale_margin_report_list" model="ir.ui.view">
        <field name="name">sale.margin.report.list.commission</field>
        <field name="model">sale.margin.report</field>
        <field name="inherit_id" ref="deltatech_sale_margin.view_sale_margin_report_list" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_set_commission_paid"
                        aria-label="Set Paid"
                        string="Set Paid"
                        type="object"
                        icon="fa-check"
                        groups="deltatech_sale_commission.group_commission_manager"
                    />
                </header>
            </xpath>
            <field name="profit_val" position="after">
                <field name="commission_paid" />
            </field>
        </field>
    </record>


    <record id="view_sale_margin_report_commission_form" model="ir.ui.view">
        <field name="name">sale.margin.report.commission.form</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="partner_id" invisible="1" />
                            <field name="commercial_partner_id" />
                            <field name="invoice_id" />
                        </group>
                        <group>
                            <field name="purchase_price" readonly="id &lt; 0" />
                            <field name="user_id" readonly="id &lt; 0" />
                        </group>
                        <group>
                            <field name="product_uom_qty" />
                            <field name="sale_val" />
                            <field name="stock_val" />
                            <field name="profit_val" />
                            <field name="currency_id" />
                        </group>
                        <group>
                            <field name="commission_computed" />
                            <field name="commission" readonly="id &lt; 0" />
                            <field name="commission_paid" readonly="id &lt; 0" />
                        </group>
                        <group name="managers">
                            <field name="manager_user_id" />
                            <field name="commission_manager_computed" />
                            <field name="director_user_id" />
                            <field name="commission_director_computed" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_sale_margin_report_commission_list" model="ir.ui.view">
        <field name="name">sale.margin.report.commission.list</field>
        <field name="model">sale.margin.report</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list delete="false" create="false">
                <header>
                    <button
                        name="action_set_commission_paid"
                        aria-label="Set Paid"
                        string="Set Paid"
                        type="object"
                        icon="fa-check"
                        groups="deltatech_sale_commission.group_commission_manager"
                    />
                </header>
                <field name="date" column_invisible="1" />
                <field name="due_date" />
                <field name="payment_term_id" />
                <field name="categ_id" column_invisible="1" />
                <field name="product_id" />
                <field name="user_id" />
                <field name="partner_id" column_invisible="1" />
                <field name="commercial_partner_id" />
                <field name="invoice_id" />
                <field name="product_uom_qty" sum="Qty" />
                <field name="purchase_price" optional="hide" />
                <field name="sale_val" sum="Sale value" />
                <field name="stock_val" sum="Stock value" />
                <field name="profit_val" sum="Profit" />
                <field name="commission_computed" sum="Commission Computed" />
                <field name="commission" sum="Commission" />
                <field name="commission_paid" optional="show" />
                <field name="markup" optional="hide" />
                <field name="payment_state" optional="hide" />
                <field name="profit_margin" optional="hide" />
                <field name="manager_user_id" optional="hide" />
                <field name="commission_manager_computed" optional="hide" />
                <field name="director_user_id" optional="hide" />
                <field name="commission_director_computed" optional="hide" />
                <field name="company_id" column_invisible="1" groups="base.group_multi_company" />
                <field name="move_type" column_invisible="1" />
                <field name="state" column_invisible="1" />
                <field name="currency_id" optional="hide" />
                <field name="journal_id" optional="hide" />
            </list>
        </field>
    </record>


    <record id="view_sale_margin_report_filter" model="ir.ui.view">
        <field name="name">sale.margin.report.select.commission</field>
        <field name="model">sale.margin.report</field>
        <field name="inherit_id" ref="deltatech_sale_margin.view_sale_margin_report_filter" />
        <field name="arch" type="xml">
            <filter name="open" position="after">
                <separator />
                <filter
                    string="Commission Not Paid"
                    name="commission_not_paid"
                    domain="[('commission_paid','=',False)]"
                />
                <filter string="Commission Paid" name="commission_paid" domain="[('commission_paid','=',True)]" />
            </filter>
            <filter name="status" position="after">
                <filter
                    string="Commission Paid"
                    name="group_by_commission_paid"
                    context="{'group_by':'commission_paid'}"
                />
            </filter>
        </field>
    </record>

    <!-- the commission roles keep the margin report and the cost wizard they had -->
    <record id="deltatech_sale_margin.menu_sale_margin_report_list" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.link(ref('group_commission_viewer'))]" />
    </record>

    <record id="deltatech_sale_margin.action_commission_update_purchase_price" model="ir.actions.act_window">
        <field name="group_ids" eval="[Command.link(ref('group_commission_manager'))]" />
    </record>

    <record id="action_sale_margin_commission_report" model="ir.actions.act_window">
        <field name="name">Commission</field>
        <field name="res_model">sale.margin.report</field>

        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_margin_report_commission_list" />
        <field name="search_view_id" ref="view_sale_margin_report_filter" />
        <field name="context">{"search_default_filter_date":1, 'search_default_paid':1}</field>
        <field name="domain">[('move_type','in',['out_invoice','out_refund','out_receipt'])]</field>
    </record>


    <menuitem
        name="Commission"
        id="menu_commission"
        parent="sale.sale_order_menu"
        sequence="700"
        groups="group_commission_viewer"
    />
    <menuitem
        action="action_sale_margin_commission_report"
        id="menu_sale_margin_commission_report_list"
        parent="menu_commission"
    />

</odoo>
