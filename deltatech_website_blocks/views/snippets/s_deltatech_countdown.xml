<odoo>
    <template id="s_deltatech_countdown" name="Countdown">
        <section
            class="s_deltatech_countdown o_colored_level"
            data-snippet="s_deltatech_countdown"
            data-name="Countdown"
        >
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 text-center">
                        <h2 class="mb-4">Limited Time Offer!</h2>
                        <div
                            class="s_deltatech_countdown_container d-flex justify-content-center gap-3"
                            data-end-date=""
                            data-confetti="true"
                            data-expired-message="Offer Expired"
                        >
                            <div class="countdown-item">
                                <span class="countdown-value days">00</span>
                                <span class="countdown-label">Days</span>
                            </div>
                            <div class="countdown-item">
                                <span class="countdown-value hours">00</span>
                                <span class="countdown-label">Hours</span>
                            </div>
                            <div class="countdown-item">
                                <span class="countdown-value minutes">00</span>
                                <span class="countdown-label">Minutes</span>
                            </div>
                            <div class="countdown-item">
                                <span class="countdown-value seconds">00</span>
                                <span class="countdown-label">Seconds</span>
                            </div>
                        </div>
                        <div class="s_deltatech_countdown_expired d-none mt-4">
                            <h3 class="oe_structure">Offer Expired</h3>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
