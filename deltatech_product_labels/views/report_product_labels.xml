<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- paper formats with the exact size of the labels, so the labels do not move from page to page -->
    <record id="paperformat_label_a4_3x8" model="report.paperformat">
        <field name="name">Labels A4 3x8 (70x37 mm)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>

    <record id="paperformat_label_100x50" model="report.paperformat">
        <field name="name">Label 100x50 mm</field>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">50</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>

    <record id="paperformat_label_40x25" model="report.paperformat">
        <field name="name">Label 40x25 mm</field>
        <field name="format">custom</field>
        <field name="page_width">40</field>
        <field name="page_height">25</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>

    <record id="report_product_product_label_a4_3x8" model="ir.actions.report">
        <field name="name">Product labels A4 3x8 (70x37 mm)</field>
        <field name="model">product.product.label</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">deltatech_product_labels.product_product_label_a4_3x8</field>
        <field name="report_file">deltatech_product_labels.product_product_label_a4_3x8</field>
        <field name="paperformat_id" ref="paperformat_label_a4_3x8" />
        <field name="binding_model_id" ref="deltatech_product_labels.model_product_product_label" />
        <field name="binding_type">report</field>
    </record>

    <record id="report_product_product_label_100x50" model="ir.actions.report">
        <field name="name">Product labels 100x50 mm (thermal printer)</field>
        <field name="model">product.product.label</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">deltatech_product_labels.product_product_label_100x50</field>
        <field name="report_file">deltatech_product_labels.product_product_label_100x50</field>
        <field name="paperformat_id" ref="paperformat_label_100x50" />
        <field name="binding_model_id" ref="deltatech_product_labels.model_product_product_label" />
        <field name="binding_type">report</field>
    </record>

    <record id="report_product_product_label_40x25" model="ir.actions.report">
        <field name="name">Product labels 40x25 mm (thermal printer)</field>
        <field name="model">product.product.label</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">deltatech_product_labels.product_product_label_40x25</field>
        <field name="report_file">deltatech_product_labels.product_product_label_40x25</field>
        <field name="paperformat_id" ref="paperformat_label_40x25" />
        <field name="binding_model_id" ref="deltatech_product_labels.model_product_product_label" />
        <field name="binding_type">report</field>
    </record>

    <record id="report_product_product_label" model="ir.actions.report">
        <field name="name">Product labels (continuous)</field>
        <field name="model">product.product.label</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">deltatech_product_labels.product_product_label</field>
        <field name="report_file">deltatech_product_labels.product_product_label</field>
        <field name="binding_model_id" ref="deltatech_product_labels.model_product_product_label" />
        <field name="binding_type">report</field>
    </record>

    <template id="label_layout">
        <t t-call="web.html_container">
            <div class="page">
                <style>
                    .product_label {
                    page-break-inside: avoid;
                    border: ridge;
                    overflow: hidden;
                    border-width: thin;
                    line-height: initial;
                    text-overflow: ellipsis;
                    }
                    .col-xs-4 {
                    padding-left: 1px;
                    padding-right: 1px;
                    }
                </style>
                <div class="article">
                    <t t-out="0" />
                </div>
            </div>
        </t>
    </template>
    <!-- layout for labels of a fixed size: no borders, no margins, the size is set by each report -->
    <template id="label_layout_fixed">
        <t t-call="web.html_container">
            <div class="page">
                <div class="article">
                    <style>
                        body.o_body_pdf, .page, .article {
                        margin: 0 !important;
                        padding: 0 !important;
                        max-width: none !important;
                        }
                        .dt_label {
                        box-sizing: border-box;
                        overflow: hidden;
                        line-height: 1.15;
                        color: #000;
                        font-family: "DejaVu Sans", Arial, Helvetica, sans-serif;
                        }
                        .dt_label_name {
                        overflow: hidden;
                        font-weight: bold;
                        }
                        .dt_label_table {
                        width: 100%;
                        border-collapse: collapse;
                        }
                        .dt_label_table, .dt_label_table * {
                        border: 0 none !important;
                        background: none !important;
                        }
                        .dt_label_table td {
                        padding: 0 !important;
                        vertical-align: bottom;
                        }
                        .dt_label_barcode {
                        display: block;
                        }
                        .dt_label_small {
                        overflow: hidden;
                        white-space: nowrap;
                        }
                        .dt_label_price {
                        text-align: right;
                        white-space: nowrap;
                        font-weight: bold;
                        }
                        .dt_label_price_note {
                        text-align: right;
                        white-space: nowrap;
                        }
                        .dt_sheet .dt_label {
                        float: left;
                        }
                        .dt_page_break {
                        clear: both;
                        page-break-after: always;
                        }
                    </style>
                    <t t-out="0" />
                </div>
            </div>
        </t>
    </template>
    <!-- price of a label, with the variables line, price_style and note_style -->
    <template id="label_price">
        <t t-if="line.price_incl">
            <div class="dt_label_price" t-att-style="price_style">
                <t
                    t-out="line.price_incl"
                    t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"
                />
            </div>
            <div class="dt_label_price_note" t-att-style="note_style">
                VAT incl. /
                <t t-out="line.product_id.uom_id.name" />
            </div>
        </t>
    </template>
    <template id="set_barcode">
        <t t-set="code" t-value="line.product_id.barcode or line.product_id.default_code" />
        <t t-if="code and line.barcode_image">
            <t t-set="image_barcode" t-value="image_data_uri(line.barcode_image)" />
            <style>
                .barcode
                <t t-out="line.product_id.id" />
                {
                background-repeat: no-repeat;
                width: 100%;
                height: 100%;
                background-size : 100% 100%;
                background-image: url(
                <t t-out="image_barcode" />
                )
                }
            </style>
        </t>
    </template>
    <template id="product_product_label">
        <t t-call="deltatech_product_labels.label_layout">
            <t t-foreach="docs" t-as="label">
                <t t-foreach="label.label_lines" t-as="line">
                    <t t-call="deltatech_product_labels.set_barcode" />
                    <t t-foreach="range(int(line.quantity))" t-as="range_line">
                        <div class='product_label'>
                            <strong t-field="line.product_id.display_name" />
                            <t t-set="code" t-value="line.product_id.barcode or line.product_id.default_code" />
                            <span t-if="code">
                                <img t-att-class="'barcode%s' % line.product_id.id" />
                                <span t-out="code" />
                            </span>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
    <!-- 24 labels on an A4 sheet, 3 columns x 8 rows: shelf, warehouse or product labels -->
    <template id="product_product_label_a4_3x8">
        <t t-call="deltatech_product_labels.label_layout_fixed">
            <t t-set="lines" t-value="docs._get_print_lines()" />
            <div class="dt_sheet">
                <t t-foreach="lines" t-as="line">
                    <div class="dt_label" style="width: 33.33%; height: 37mm; padding: 2.5mm 3mm 2mm 3mm">
                        <div class="dt_label_name" style="font-size: 9.5pt; height: 8.6mm">
                            <t t-out="line.product_id.with_context(display_default_code=False).display_name" />
                        </div>
                        <table class="dt_label_table" style="margin-top: 1mm">
                            <tr>
                                <td style="width: 38mm">
                                    <img
                                        t-if="line.barcode_image"
                                        class="dt_label_barcode"
                                        t-att-src="image_data_uri(line.barcode_image)"
                                        style="width: 36mm; height: 14mm"
                                    />
                                    <div class="dt_label_small" style="font-size: 7pt; margin-top: 0.5mm">
                                        <t t-out="line.product_id.default_code or ''" />
                                        <t t-if="line.lot">
                                            · Lot:
                                            <t t-out="line.lot" />
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <t t-set="price_style" t-value="'font-size: 15pt'" />
                                    <t t-set="note_style" t-value="'font-size: 6pt'" />
                                    <t t-call="deltatech_product_labels.label_price" />
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div t-if="line_index % 24 == 23 and not line_last" class="dt_page_break" />
                </t>
            </div>
        </t>
    </template>
    <!-- one label per page, for thermal printers loaded with 100x50 mm labels -->
    <template id="product_product_label_100x50">
        <t t-call="deltatech_product_labels.label_layout_fixed">
            <t t-set="lines" t-value="docs._get_print_lines()" />
            <t t-foreach="lines" t-as="line">
                <div class="dt_label" style="width: 100mm; height: 49mm; padding: 3mm 4mm">
                    <div class="dt_label_name" style="font-size: 13pt; height: 11.5mm">
                        <t t-out="line.product_id.with_context(display_default_code=False).display_name" />
                    </div>
                    <table class="dt_label_table" style="margin-top: 2mm">
                        <tr>
                            <td style="width: 54mm">
                                <img
                                    t-if="line.barcode_image"
                                    class="dt_label_barcode"
                                    t-att-src="image_data_uri(line.barcode_image)"
                                    style="width: 52mm; height: 22mm"
                                />
                                <div class="dt_label_small" style="font-size: 9pt; margin-top: 1mm">
                                    <t t-out="line.product_id.default_code or ''" />
                                    <t t-if="line.lot">
                                        · Lot:
                                        <t t-out="line.lot" />
                                    </t>
                                </div>
                            </td>
                            <td>
                                <t t-set="price_style" t-value="'font-size: 24pt'" />
                                <t t-set="note_style" t-value="'font-size: 8pt'" />
                                <t t-call="deltatech_product_labels.label_price" />
                            </td>
                        </tr>
                    </table>
                </div>
                <div t-if="not line_last" class="dt_page_break" />
            </t>
        </t>
    </template>
    <!-- one label per page, for thermal printers loaded with 40x25 mm labels -->
    <template id="product_product_label_40x25">
        <t t-call="deltatech_product_labels.label_layout_fixed">
            <t t-set="lines" t-value="docs._get_print_lines()" />
            <t t-foreach="lines" t-as="line">
                <div class="dt_label" style="width: 40mm; height: 24mm; padding: 1.2mm 1.5mm">
                    <div class="dt_label_name" style="font-size: 6pt; height: 5.8mm">
                        <t t-out="line.product_id.with_context(display_default_code=False).display_name" />
                    </div>
                    <img
                        t-if="line.barcode_image"
                        class="dt_label_barcode"
                        t-att-src="image_data_uri(line.barcode_image)"
                        style="width: 37mm; height: 9.5mm; margin-top: 0.6mm"
                    />
                    <table class="dt_label_table" style="margin-top: 0.5mm">
                        <tr>
                            <td class="dt_label_small" style="font-size: 5.5pt">
                                <t t-out="line.product_id.default_code or ''" />
                                <div t-if="line.lot">
                                    Lot:
                                    <t t-out="line.lot" />
                                </div>
                            </td>
                            <td t-if="line.price_incl" class="dt_label_price" style="font-size: 9pt">
                                <t
                                    t-out="line.price_incl"
                                    t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"
                                />
                            </td>
                        </tr>
                    </table>
                </div>
                <div t-if="not line_last" class="dt_page_break" />
            </t>
        </t>
    </template>
</odoo>
