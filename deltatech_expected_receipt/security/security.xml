<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="privilege_expected_receipt" model="res.groups.privilege">
        <field name="name">Expected Receipts</field>
    </record>

    <!-- Casierul încasează cu cardul și își vede propriile încasări; nu primește niciun drept
         contabil: plata se scrie cu sudo, după verificările din dialog. -->
    <record id="group_cashier" model="res.groups">
        <field name="name">Card Cashier</field>
        <field name="privilege_id" ref="privilege_expected_receipt" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_expected_receipt" />
        <field name="implied_ids" eval="[(4, ref('group_cashier')), (4, ref('account.group_account_readonly'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_manager'))]" />
    </record>
</odoo>
