<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="privilege_expected_receipt" model="res.groups.privilege">
        <field name="name">Expected Receipts</field>
    </record>

    <!-- Casierul încasează cu cardul și își vede propriile încasări; nu primește niciun drept
         contabil: plata se scrie cu sudo, după verificările din dialog. -->
    <record id="group_cashier" model="res.groups">
        <field name="name">Card Cashier</field>
        <field name="privilege_id" ref="privilege_expected_receipt" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_expected_receipt" />
        <field name="implied_ids" eval="[(4, ref('group_cashier')), (4, ref('account.group_account_readonly'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_manager'))]" />
    </record>

    <record id="rule_expected_receipt_company" model="ir.rule">
        <field name="name">Expected receipt: multi-company</field>
        <field name="model_id" ref="model_deltatech_expected_receipt" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_card_terminal_company" model="ir.rule">
        <field name="name">Card terminal: multi-company</field>
        <field name="model_id" ref="model_deltatech_card_terminal" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_expected_receipt_cashier" model="ir.rule">
        <field name="name">Expected receipt: cashier sees own receipts</field>
        <field name="model_id" ref="model_deltatech_expected_receipt" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_cashier'))]" />
    </record>
    <record id="rule_expected_receipt_manager" model="ir.rule">
        <field name="name">Expected receipt: manager sees all</field>
        <field name="model_id" ref="model_deltatech_expected_receipt" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_manager')), (4, ref('account.group_account_readonly'))]" />
    </record>
</odoo>
