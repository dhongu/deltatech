<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.card.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                <button
                    name="action_card_payment"
                    string="Card Payment"
                    type="object"
                    groups="deltatech_expected_receipt.group_cashier"
                    invisible="state != 'posted' or move_type != 'out_invoice' or payment_state not in ('not_paid', 'partial')"
                />
                <button
                    name="action_view_card_receipts"
                    string="Card Payments"
                    type="object"
                    class="btn-link"
                    groups="deltatech_expected_receipt.group_cashier"
                    invisible="move_type != 'out_invoice'"
                />
            </xpath>
        </field>
    </record>
</odoo>
