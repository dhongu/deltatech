<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_card_settlement_form" model="ir.ui.view">
        <field name="name">deltatech.card.settlement.form</field>
        <field name="model">deltatech.card.settlement</field>
        <field name="arch" type="xml">
            <form string="Card Settlement">
                <field name="state" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <group>
                    <group>
                        <field name="statement_line_id" />
                        <field name="terminal_id" />
                    </group>
                    <group>
                        <field name="date" />
                        <field name="amount" />
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not message">
                    <field name="message" nolabel="1" />
                </div>
                <field name="line_ids" invisible="state == 'search'" nolabel="1">
                    <list editable="bottom" create="0" delete="0" decoration-info="combo">
                        <field name="selected" widget="boolean_toggle" />
                        <field name="combo" />
                        <field name="date" />
                        <field name="partner_id" />
                        <field name="document_name" />
                        <field name="terminal_id" />
                        <field name="amount" sum="Total" />
                        <field name="currency_id" column_invisible="1" />
                        <field name="receipt_id" column_invisible="1" />
                    </list>
                </field>
                <group invisible="state == 'search'">
                    <group>
                        <field name="selected_count" />
                        <field name="selected_total" />
                    </group>
                    <group>
                        <field name="difference" decoration-danger="difference != 0" />
                        <field name="can_settle" invisible="1" />
                    </group>
                </group>
                <footer>
                    <button name="action_search" string="Search" type="object" class="btn-primary" invisible="state != 'search'" />
                    <button name="action_search" string="Search Again" type="object" invisible="state == 'search'" />
                    <button name="action_settle" string="Settle" type="object" class="btn-primary" invisible="not can_settle" />
                    <button name="action_select_none" string="Untick All" type="object" invisible="state == 'search'" />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_card_settlement" model="ir.actions.act_window">
        <field name="name">Card Settlement</field>
        <field name="res_model">deltatech.card.settlement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
