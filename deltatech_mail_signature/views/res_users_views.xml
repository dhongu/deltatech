<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_simple_modif_signature" model="ir.ui.view">
        <field name="name">res.users.preferences.form.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <field name="signature" position="after">
                <div colspan="2" class="d-flex align-items-center gap-2">
                    <button
                        name="action_regenerate_signature"
                        type="object"
                        string="Regenerate my signature"
                        icon="fa-refresh"
                        class="btn-secondary"
                    />
                    <field name="mail_signature_generated" widget="boolean" readonly="1" invisible="not mail_signature_generated" />
                    <label for="mail_signature_generated" invisible="not mail_signature_generated" class="text-muted" />
                </div>
            </field>
        </field>
    </record>

    <record id="view_users_form_signature" model="ir.ui.view">
        <field name="name">res.users.form.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <field name="signature" position="after">
                <div colspan="2" class="d-flex align-items-center gap-2">
                    <button
                        name="action_regenerate_signature"
                        type="object"
                        string="Regenerate signature"
                        icon="fa-refresh"
                        class="btn-secondary"
                    />
                    <field name="mail_signature_generated" widget="boolean" readonly="1" invisible="not mail_signature_generated" />
                    <label for="mail_signature_generated" invisible="not mail_signature_generated" class="text-muted" />
                </div>
            </field>
        </field>
    </record>
</odoo>
