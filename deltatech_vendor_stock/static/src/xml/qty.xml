<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template">

    <t t-name="qtyAtDate" t-inherit="sale_stock.QtyAtDate" t-inherit-mode="extension" owl="1">
        <xpath expr="//a" position="replace">
            <t t-set="stock_colors" t-value="stockColors or {}" />
            <t t-set="icon_color" t-value="stock_colors.color_default or '#007bff'" />

            <t t-if="calcData.will_be_fulfilled">
                <t t-set="icon_color" t-value="stock_colors.color_fulfilled or '#28a745'" />
                <t t-if="!props.record.data.free_qty_today">
                    <t t-set="icon_color" t-value="stock_colors.color_fulfilled_no_free_qty or '#17a2b8'" />
                </t>
            </t>
            <t t-else="">
                <t t-set="icon_color" t-value="stock_colors.color_not_fulfilled or '#dc3545'" />
                <t t-if="props.record.data.vendor_qty_available">
                    <t t-set="icon_color" t-value="stock_colors.color_vendor_available or '#ffc107'" />
                </t>
            </t>

            <a
                t-att-tabindex="props.record.data.display_qty_widget ? '0' : '-1'"
                t-att-class="!props.record.data.display_qty_widget ? 'invisible' : ''"
                t-on-click="showPopup"
                t-att-style="'color: ' + icon_color"
                class="fa fa-area-chart cursor-pointer"
            />
        </xpath>
    </t>


    <t t-name="QtyDetailPopOver" t-inherit="sale_stock.QtyAtDatePopover" t-inherit-mode="extension" owl="1">
        <!-- many2one values are {id, display_name} objects, not [id, name] pairs -->
        <xpath expr="//t[@t-out='props.record.data.product_uom_id[1]']" position="attributes">
            <attribute name="t-out">props.record.data.product_uom_id?.display_name</attribute>
        </xpath>
        <xpath expr="//t[@t-out='props.record.data.product_uom_id[1]']" position="attributes">
            <attribute name="t-out">props.record.data.product_uom_id?.display_name</attribute>
        </xpath>
        <xpath expr="//t[@t-out='props.record.data.product_uom_id[1]']" position="attributes">
            <attribute name="t-out">props.record.data.product_uom_id?.display_name</attribute>
        </xpath>
        <xpath expr="//tbody" position="inside">
            <t t-if="props.calcData.warehouse_stock?.length">
                <tr>
                    <td colspan="2" class="border-top pt-2">
                        <strong>Free Stock per Warehouse</strong>
                    </td>
                </tr>
                <tr t-foreach="props.calcData.warehouse_stock" t-as="row" t-key="row.warehouse_id">
                    <td>
                        <a
                            href="#"
                            role="button"
                            title="View the forecast for this warehouse"
                            t-on-click.prevent="() => this.openWarehouseForecast(row)"
                        >
                            <strong t-out="row.code" />
                            <small t-if="row.name !== row.code" class="text-muted ms-1" t-out="row.name" />
                        </a>
                        <span t-if="row.is_order_warehouse" class="badge rounded-pill text-bg-primary ms-1">Order</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <b t-att-class="warehouseStockClass(row)" t-out="row.qty" />
                        <t t-out="' ' + (props.record.data.product_uom_id?.display_name or '')" />
                    </td>
                </tr>
            </t>
            <tr t-if="props.record.data.vendor_qty_available">
                <td>
                    <strong>Vendor Stock</strong>
                </td>
                <td class="text-end text-nowrap">
                    <b t-out='props.record.data.vendor_qty_available' />
                    <t t-out="' ' + (props.record.data.product_uom_id?.display_name or '')" />
                </td>
            </tr>
            <tr t-if="props.record.data.other_qty_available">
                <td>
                    <strong>Other Stock</strong>
                </td>
                <td class="text-end text-nowrap">
                    <b t-out='props.record.data.other_qty_available' />
                    <t t-out="' ' + (props.record.data.product_uom_id?.display_name or '')" />
                </td>
            </tr>
        </xpath>
    </t>


</templates>
