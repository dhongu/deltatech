<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template">

    <t t-name="qtyAtDate" t-inherit="sale_stock.QtyAtDate" t-inherit-mode="extension" owl="1">
        <xpath expr="//a" position="replace">
            <t t-set="text_color">text-primary</t>

            <t t-if="calcData.will_be_fulfilled ">
                <t t-set="text_color">text-success</t>
                <t t-if="!props.record.data.free_qty_today">
                    <t t-set="text_color">text-info</t>
                </t>
            </t>
            <t t-else="">
                <t t-set="text_color">text-danger</t>
                <t t-if="props.record.data.vendor_qty_available">
                    <t t-set="text_color">text-warning</t>
                </t>
            </t>

            <a
                t-att-tabindex="props.record.data.display_qty_widget ? '0' : '-1'"
                t-att-class="!props.record.data.display_qty_widget ? 'invisible' : ''"
                t-on-click="showPopup"
                t-attf-class="fa fa-area-chart cursor-pointer {{ text_color }}"
            />
        </xpath>
    </t>


    <t t-name="QtyDetailPopOver" t-inherit="sale_stock.QtyAtDatePopover" t-inherit-mode="extension" owl="1">
        <xpath expr="//tbody" position="inside">
            <tr>
                <td>
                    <strong>Vendor Stock</strong>
                </td>
                <td>
                    <b t-out='props.record.data.vendor_qty_available' />
                    <t t-out='props.record.data.product_uom[1]' />
                </td>
            </tr>
            <tr t-if="props.record.data.other_qty_available">
                <td>
                    <strong>Other Stock</strong>
                </td>
                <td class="text-end">
                    <b t-out='props.record.data.other_qty_available' />
                    <t t-out='props.record.data.product_uom[1]' />
                </td>
            </tr>
            <tr t-if="props.record.data.warehouse_stock">
                <td>
                    <strong>Warehouse Stock</strong>
                </td>
                <td class="text-end">
                    <b t-out='props.record.data.warehouse_stock' />
                </td>
            </tr>
        </xpath>
    </t>


</templates>
