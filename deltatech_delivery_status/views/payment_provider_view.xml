<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <!-- 20.0: grupul `payment_state` a dispărut odată cu `payment.provider.state`
                 (înlocuit de `is_live`); câmpul rămâne în același grup de sus al formularului. -->
            <field name="is_live" position="after">
                <field name="postponed_delivery" />
            </field>
        </field>
    </record>
</odoo>
