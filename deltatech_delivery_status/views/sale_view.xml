<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_order_form" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//form//header//button[@name='action_draft']" position="after">
                    <field name="postponed_delivery" invisible="1" />
                     <button
                    name="postpone_delivery"
                    type="object"
                    groups="stock.group_stock_user"
                    invisible="postponed_delivery or not delivery_count"
                    string="Postpone"
                    icon="fa-pause"
                    help="Postpone the delivery of the products"
                />
                     <button
                    name="release_delivery"
                    type="object"
                    groups="stock.group_stock_user"
                    invisible="not postponed_delivery or not delivery_count"
                    string="Release"
                    icon="fa-play"
                    help="Release the postponed delivery of the products"
                />
                </xpath>
            </field>
        </record>
</odoo>
