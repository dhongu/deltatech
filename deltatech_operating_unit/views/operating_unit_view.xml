<odoo>
    <record id="view_operating_unit_tree" model="ir.ui.view">
        <field name="name">operating.unit.tree</field>
        <field name="model">deltatech.operating.unit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="groups_ids" />
            </tree>
        </field>
    </record>

    <record id="view_operating_unit_form" model="ir.ui.view">
        <field name="name">operating.unit.form</field>
        <field name="model">deltatech.operating.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="groups_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_operating_unit" model="ir.actions.act_window">
        <field name="name">Operating Units</field>
        <field name="res_model">deltatech.operating.unit</field>
        <field name="view_mode">tree,form</field>
    </record>
<!--base.next_id_2-->
    <menuitem id="menu_operating_unit" name="Operating Units" parent="base.next_id_2" action="action_operating_unit" />
</odoo>
