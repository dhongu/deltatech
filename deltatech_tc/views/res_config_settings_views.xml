<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deltatech_tc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Terrabit Connect — Auto-update" id="deltatech_tc_update">
                    <setting string="Update Repository"
                             help="GitHub repo (owner/name) where agent releases are published">
                        <field name="deltatech_tc_update_repo" placeholder="dhongu/terrabit-anaf-agent"/>
                    </setting>
                    <setting string="Update Token"
                             help="Read-only GitHub token for the private agent repo. Stays server-side; stations get the update proxied by Odoo.">
                        <field name="deltatech_tc_update_token" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
