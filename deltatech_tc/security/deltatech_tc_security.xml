<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="groups_privilege_deltatech_tc" model="res.groups.privilege">
        <field name="name">Terrabit Connect</field>
    </record>

    <record id="group_deltatech_tc_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="groups_privilege_deltatech_tc"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_deltatech_tc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="groups_privilege_deltatech_tc"/>
        <field name="implied_ids" eval="[(4, ref('group_deltatech_tc_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_deltatech_tc_station_company" model="ir.rule">
        <field name="name">Terrabit Connect Station: multi-company</field>
        <field name="model_id" ref="model_deltatech_tc_station"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_deltatech_tc_job_company" model="ir.rule">
        <field name="name">Terrabit Connect Job: multi-company</field>
        <field name="model_id" ref="model_deltatech_tc_job"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
