<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.move.template</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref'][@invisible=&quot;move_type != 'entry'&quot;]" position="after">
                <field name="move_template_id" invisible="not move_template_id" />
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">account.move.select.move.template</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="move_template_id" />
            </field>
            <filter name="posted" position="after">
                <filter
                    name="from_template"
                    string="From Template"
                    domain="[('move_template_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>
</odoo>
