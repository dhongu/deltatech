<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="31" />
            <field name="inherit_id" ref="sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@name='invoicing_setting_container']" position="inside">
                    <setting id="sale_feedback_email">
                         <field name="sale_feedback" />

                            <div invisible="not sale_feedback">
                                <label for="sale_feedback_template_id" class="o_light_label me-2" />
                                <field
                            name="sale_feedback_template_id"
                            class="oe_inline"
                            context="{'default_model': 'account.move'}"
                            options="{'no_create': True}"
                        />
                            </div>
                    </setting>
                </xpath>

            </field>
        </record>



</odoo>
