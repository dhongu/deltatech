<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_pickup_address" model="ir.ui.view">
        <field name="name">purchase.order.form.pickup.address.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_pickup_address_id" context="{'default_company_id': company_id}"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_preview_purchase_order" string="Preview" type="object" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
