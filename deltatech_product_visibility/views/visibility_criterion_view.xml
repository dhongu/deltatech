<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="visibility_criterion_view_list" model="ir.ui.view">
        <field name="name">deltatech.product.visibility.criterion.list</field>
        <field name="model">deltatech.product.visibility.criterion</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="weight" sum="Total" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="visibility_criterion_view_form" model="ir.ui.view">
        <field name="name">deltatech.product.visibility.criterion.form</field>
        <field name="model">deltatech.product.visibility.criterion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="weight" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="visibility_criterion_action" model="ir.actions.act_window">
        <field name="name">Criterii vizibilitate produs</field>
        <field name="res_model">deltatech.product.visibility.criterion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Definește criteriile și ponderile scorului de vizibilitate</p>
            <p>Ponderile pot fi ajustate fără cod. După modificare, folosește butonul „Recalculează scorurile".</p>
        </field>
    </record>

    <record id="visibility_recompute_action" model="ir.actions.server">
        <field name="name">Recalculează scorurile de vizibilitate</field>
        <field name="model_id" ref="model_deltatech_product_visibility_criterion" />
        <field name="binding_model_id" ref="model_deltatech_product_visibility_criterion" />
        <field name="state">code</field>
        <field name="code">action = model.action_recompute_scores()</field>
    </record>

    <menuitem
        id="menu_visibility_criterion"
        name="Vizibilitate produs"
        parent="sale.menu_sale_config"
        action="visibility_criterion_action"
        sequence="90"
    />

</odoo>
