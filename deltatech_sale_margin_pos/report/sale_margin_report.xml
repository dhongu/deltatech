<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sale_margin_report_list" model="ir.ui.view">
        <field name="name">sale.margin.report.list.pos</field>
        <field name="model">sale.margin.report</field>
        <field name="inherit_id" ref="deltatech_sale_margin.view_sale_margin_report_list" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="pos_order_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_sale_margin_report_filter" model="ir.ui.view">
        <field name="name">sale.margin.report.filter.pos</field>
        <field name="model">sale.margin.report</field>
        <field name="inherit_id" ref="deltatech_sale_margin.view_sale_margin_report_filter" />
        <field name="arch" type="xml">
            <filter name="paid" position="before">
                <filter string="POS Sales" name="pos_sales" domain="[('pos_order_id', '!=', False)]" />
                <filter string="Invoices" name="invoices" domain="[('invoice_id', '!=', False)]" />
                <separator />
            </filter>
            <field name="invoice_id" position="after">
                <field name="pos_order_id" />
            </field>
            <filter name="invoice" position="after">
                <filter string="POS Order" name="pos_order" context="{'group_by': 'pos_order_id'}" />
            </filter>
        </field>
    </record>

</odoo>
