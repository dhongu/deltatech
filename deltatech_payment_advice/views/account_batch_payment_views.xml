<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_advice" model="ir.ui.view">
        <field name="name">account.batch.payment.form.payment.advice</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_send_payment_advice" type="object"
                        string="Send Payment Advice"
                        invisible="batch_type != 'outbound' or not payment_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
