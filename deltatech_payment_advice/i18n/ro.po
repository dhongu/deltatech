#. module: deltatech_payment_advice
#: model:mail.template,body_html:deltatech_payment_advice.mail_template_payment_advice
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Dear Sir or Madam,</p>\n"
"                <p>Please find attached the payment advice for the invoices we have settled.</p>\n"
"                <p>This is an automatic notification. For further information, please contact us.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Stimată Doamnă, Stimate Domn,</p>\n"
"                <p>Găsiți atașat avizul de plată pentru facturile pe care le-am achitat.</p>\n"
"                <p>Aceasta este o înștiințare automată. Pentru informații suplimentare, vă rugăm să ne contactați.</p>\n"
"            </div>\n"
"        "

