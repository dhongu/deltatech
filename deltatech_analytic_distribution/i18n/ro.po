#. module: deltatech_analytic_distribution
#: model:ir.model.fields,help:deltatech_analytic_distribution.field_res_config_settings__analytic_distribution_validation_enabled
msgid ""
"Enable or disable the validation of analytic distribution in account moves."
msgstr ""
"Activează sau dezactivează validarea distribuției analitice în mișcările "
"contabile."

#. module: deltatech_analytic_distribution
#. odoo-python
#: code:addons/deltatech_analytic_distribution/models/account_move.py:0
#, python-format
msgid ""
"Invalid distribution, all distribution lines need to have: Location, "
"Department and Line of Business."
msgstr ""
"Distribuția este invalidă, toate liniile de distribuție trebuie să aibă: "
"Locație, Departament și Linia de Business."

#. module: deltatech_analytic_distribution
#. odoo-python
#: code:addons/deltatech_analytic_distribution/models/account_move.py:0
#, python-format
