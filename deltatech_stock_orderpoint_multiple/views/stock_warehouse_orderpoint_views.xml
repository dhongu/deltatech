<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_orderpoint_tree_editable_qty_multiple" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.editable.qty.multiple</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <field name="replenishment_uom_id" position="after">
                <field name="qty_multiple" optional="hide" width="60"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_form_qty_multiple" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.qty.multiple</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <field name="replenishment_uom_id" position="after">
                <field name="qty_multiple"/>
            </field>
        </field>
    </record>
</odoo>
