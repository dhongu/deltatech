<?xml version="1.0" ?>
<odoo>

        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template.form.inherit.website.description</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">
<!--                <header position="inside">-->
<!--                    <button-->
<!--                    class="oe_stat_button"-->
<!--                    name="website_publish_button"-->
<!--                    string="Publish"-->
<!--                    type="object"-->
<!--                    icon="fa-globe"-->
<!--                />-->
<!--                </header>-->
                <page name="sales" position="inside">
                    <group>
                        <group string="Website description">
                            <field name='website_description' colspan="4" nolabel="1" />
                        </group>

                        <group string="Website short description">
                            <field name='website_short_description' colspan="4" nolabel="1" />
                        </group>
                    </group>
                </page>
            </field>
        </record>

        <record id="action_website_publish_product_template" model="ir.actions.server">
            <field name="name">Publish on Website</field>
            <field name="model_id" ref="product.model_product_template" />
            <field name="binding_model_id" ref="product.model_product_template" />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.action_website_publish()
            </field>
        </record>

</odoo>
