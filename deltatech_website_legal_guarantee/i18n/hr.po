#. module: deltatech_website_legal_guarantee
#: model_terms:ir.ui.view,arch_db:deltatech_website_legal_guarantee.legal_guarantee_page
msgid ""
"<li class=\"o_translate_inline\">\n"
"                                    Contact us as soon as possible after you notice the problem, by phone,\n"
"                                    e-mail or through the <a href=\"/contactus\">contact form</a>.\n"
"                                </li>"
msgstr ""
"<li class=\"o_translate_inline\">\n"
"                                    Obratite nam se što prije nakon što primijetite problem, telefonom, e-poštom ili putem <a href=\"/contactus\">kontaktnog obrasca</a>.\n"
"                                </li>"

#. module: deltatech_website_legal_guarantee
#: model_terms:ir.ui.view,arch_db:deltatech_website_legal_guarantee.legal_guarantee_page
msgid ""
"<p class=\"o_translate_inline\">\n"
"                                Sellers and producers may also offer commercial guarantees. These apply in\n"
"                                addition to the legal guarantee and do not replace it. The EU GARAN label\n"
"                                marks a commercial guarantee of durability offered by the producer at no\n"
"                                extra cost, covering the whole good, for more than two years.\n"
"                                <a href=\"https://europa.eu/youreurope/commercial-guarantee-durability/index.htm\" target=\"_blank\" rel=\"noopener\">More about the GARAN label</a>.\n"
"                            </p>"
msgstr ""
"<p class=\"o_translate_inline\">\n"
"                                Prodavatelji i proizvođači mogu nuditi i komercijalna jamstva. Ona se primjenjuju uz zakonsko jamstvo i ne zamjenjuju ga. Oznaka GARAN EU-a označava komercijalno jamstvo trajnosti koje proizvođač nudi bez dodatnih troškova, a koje obuhvaća cijelu robu i traje dulje od dvije godine.\n"
"                                <a href=\"https://europa.eu/youreurope/commercial-guarantee-durability/index.htm\" target=\"_blank\" rel=\"noopener\">Više o oznaci GARAN</a>.\n"
"                            </p>"

