#. module: deltatech_website_legal_guarantee
#: model_terms:ir.ui.view,arch_db:deltatech_website_legal_guarantee.legal_guarantee_page
msgid ""
"<li class=\"o_translate_inline\">\n"
"                                    Contact us as soon as possible after you notice the problem, by phone,\n"
"                                    e-mail or through the <a href=\"/contactus\">contact form</a>.\n"
"                                </li>"
msgstr ""
"<li class=\"o_translate_inline\">\n"
"                                    Déan teagmháil linn a luaithe is féidir tar éis duit an fhadhb a thabhairt faoi deara, ar an bhfón, trí ríomhphost nó tríd an <a href=\"/contactus\">bhfoirm teagmhála</a>.\n"
"                                </li>"

#. module: deltatech_website_legal_guarantee
#: model_terms:ir.ui.view,arch_db:deltatech_website_legal_guarantee.legal_guarantee_page
msgid ""
"<p class=\"o_translate_inline\">\n"
"                                Sellers and producers may also offer commercial guarantees. These apply in\n"
"                                addition to the legal guarantee and do not replace it. The EU GARAN label\n"
"                                marks a commercial guarantee of durability offered by the producer at no\n"
"                                extra cost, covering the whole good, for more than two years.\n"
"                                <a href=\"https://europa.eu/youreurope/commercial-guarantee-durability/index.htm\" target=\"_blank\" rel=\"noopener\">More about the GARAN label</a>.\n"
"                            </p>"
msgstr ""
"<p class=\"o_translate_inline\">\n"
"                                Féadfaidh díoltóirí agus táirgeoirí ráthaíochtaí tráchtála a thairiscint freisin. Cuirtear i bhfeidhm iad sin sa bhreis ar an ráthaíocht dhlíthiúil agus ní chuirtear in ionad na ráthaíochta dlíthiúla iad. Léiríonn lipéad GARAN an Aontais Eorpaigh ráthaíocht tráchtála maidir le marthanacht a thairgeann an táirgeoir gan aon chostas breise, a chlúdaíonn an earra ar fad, ar feadh níos mó ná dhá bhliain.\n"
"                                <a href=\"https://europa.eu/youreurope/commercial-guarantee-durability/index.htm\" target=\"_blank\" rel=\"noopener\">Tuilleadh eolais faoin lipéad GARAN</a>.\n"
"                            </p>"

