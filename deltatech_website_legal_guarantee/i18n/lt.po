#: model_terms:ir.ui.view,arch_db:deltatech_website_legal_guarantee.res_config_settings_view_form
msgid "Harmonised notice on the legal guarantee of conformity (Regulation (EU) 2025/1960), on the /garantie page"
msgstr "Suderintas pranešimas apie teisinę atitikties garantiją (Reglamentas (ES) 2025/1960) puslapyje /garantie"

