<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.legal.guarantee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="order_confirmation_setting" position="after">
                <setting
                    id="legal_guarantee_setting"
                    string="EU legal guarantee notice"
                    help="Harmonised notice on the legal guarantee of conformity (Regulation (EU) 2025/1960), on the /garantie page"
                >
                    <div class="content-group">
                        <div class="mt-2">
                            <field name="legal_guarantee_footer" />
                            <label for="legal_guarantee_footer" class="o_light_label" />
                        </div>
                        <div>
                            <field name="legal_guarantee_product" />
                            <label for="legal_guarantee_product" class="o_light_label" />
                        </div>
                        <div>
                            <field name="legal_guarantee_checkout" />
                            <label for="legal_guarantee_checkout" class="o_light_label" />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
