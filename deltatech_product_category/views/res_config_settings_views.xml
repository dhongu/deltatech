<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="inside">
                <setting
                    id="company_share_product_category_setting"
                    groups="base.group_no_one"
                    help="Share your product category to all companies defined in your instance."
                >
                    <field name="company_share_product_category" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
