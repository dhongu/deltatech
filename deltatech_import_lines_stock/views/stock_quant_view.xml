<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.import.lines</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(deltatech_import_lines.action_import_lines_wizard)d"
                    string="Import Counts"
                    type="action"
                    context="{'import_lines_model': 'stock.quant'}"
                    invisible="not context.get('inventory_mode') or context.get('inventory_report_mode')"
                    groups="stock.group_stock_user"
                    display="always"
                />
            </xpath>
        </field>
    </record>
</odoo>
