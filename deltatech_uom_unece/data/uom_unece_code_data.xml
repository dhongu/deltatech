<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
<!--
    Codurile UN/ECE folosite ca `unitCode` în documentele electronice.

    Sursele: UN/ECE Recommendation 20 (unități de măsură) și Recommendation 21
    (tipuri de ambalaj, codurile cu prefixul `X`). Ambele sunt admise de
    UBL/Peppol BIS 3 și de CIUS-RO; `codUnitateMasura` din e-Transport cere
    doar 2-3 caractere alfanumerice majuscule, deci le acceptă la fel.

    ⚠️ Lista de mai jos e un SUBSET — cel folosit curent de clienții noștri —
    nu recomandarea completă, care are peste o mie de coduri. Tocmai de aceea
    codurile stau într-un model, nu într-un câmp de selecție: consultantul
    adaugă din interfață codul care îi lipsește, fără modificare de cod și
    fără deploy. Când adaugi unul, ia-l din documentul UN/ECE, nu din memorie.

    ⚠️ FIȘIERUL E `noupdate="1"`: un upgrade nu trebuie să rescrie codurile
    pe care le-a corectat sau completat clientul.
-->

    <!-- ============================= MASĂ ============================= -->
    <record id="unece_kgm" model="uom.unece.code">
        <field name="code">KGM</field>
        <field name="name">Kilogram</field>
        <field name="category">mass</field>
    </record>
