<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.packaging.material</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']/group[@name='inventory']" position="inside">
                <group name="packaging" string="Packaging materials">
                    <field name="packaging_material_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="material_type"/>
                            <field name="qty"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
