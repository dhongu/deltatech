<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.packaging.material</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']/group[@name='inventory']" position="inside">
                <group name="packaging" string="Packaging materials">
                    <field name="packaging_material_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="material_type"/>
                            <field name="qty_purchase"/>
                            <field name="qty_sale"/>
                        </list>
                    </field>
                    <field name="packaging_material_no_inherit" invisible="packaging_material_ids"/>
                    <div colspan="2" invisible="packaging_material_ids or packaging_material_no_inherit">
                        <span class="text-muted">
                            Materials taken from the product category. Add a material above to
                            configure this product on its own.
                        </span>
                        <field name="inherited_packaging_material_ids" nolabel="1" readonly="1">
                            <list create="false" delete="false" edit="false">
                                <field name="categ_id"/>
                                <field name="material_type"/>
                                <field name="qty_purchase"/>
                                <field name="qty_sale"/>
                            </list>
                        </field>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.form.packaging.material</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="packaging" string="Packaging materials">
                    <div colspan="2">
                        <span class="text-muted">
                            Materials used by the products of this category that have none of
                            their own. Subcategories without their own configuration use these
                            as well.
                        </span>
                    </div>
                    <field name="packaging_material_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="material_type"/>
                            <field name="qty_purchase"/>
                            <field name="qty_sale"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
