<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.storable.source</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting
                    id="check_storable_sale_source"
                    company_dependent="1"
                    help="Storable products are invoiced only from sale orders, so the stock leaves through the delivery. Invoices with services only are not checked."
                >
                    <field name="check_storable_sale_source" />
                </setting>
            </xpath>
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting
                    id="check_storable_purchase_source"
                    company_dependent="1"
                    help="Storable products are billed only from purchase orders, so the stock comes in through the receipt. Bills with services only are not checked."
                >
                    <field name="check_storable_purchase_source" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
