<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_purchase_target_list" model="ir.ui.view">
        <field name="name">purchase.target.list</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="year" />
                <field name="manufacturer_id" />
                <field name="target_type" />
                <field name="partner_ids" widget="many2many_tags" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_purchase_target_form" model="ir.ui.view">
        <field name="name">purchase.target.form</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bar-chart"
                            string="Achieved"
                        />
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="manufacturer_id" />
                            <field name="year" options="{'enable_formatting': false}" />
                            <field name="target_type" />
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="currency_id" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Targets" name="targets">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="quarter" />
                                    <field name="public_categ_id" placeholder="Overall" />
                                    <field name="target_value" />
                                    <field name="target_ytd" />
                                    <field name="purchase_ytd" />
                                    <field name="achieved_pct" widget="progressbar" options="{'overflow_class': 'bg-success'}" />
                                    <field name="remaining" />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_target_search" model="ir.ui.view">
        <field name="name">purchase.target.search</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="manufacturer_id" />
                <field name="year" />
                <filter
                    name="current_year"
                    string="Current Year"
                    domain="[('year', '=', context_today().year)]"
                />
                <separator />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <group>
                    <filter name="group_year" string="Year" context="{'group_by': 'year'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_target" model="ir.actions.act_window">
        <field name="name">Manufacturer Targets</field>
        <field name="res_model">purchase.target</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the purchase targets of a manufacturer</p>
            <p>One target per manufacturer and year, split per quarter and eCommerce category.</p>
        </field>
    </record>

</odoo>
