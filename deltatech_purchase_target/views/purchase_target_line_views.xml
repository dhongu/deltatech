<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_purchase_target_line_list" model="ir.ui.view">
        <field name="name">purchase.target.line.list</field>
        <field name="model">purchase.target.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="achieved_pct &lt; 100 and target_ytd" decoration-success="achieved_pct &gt;= 100">
                <field name="year" optional="hide" />
                <field name="manufacturer_id" />
                <field name="quarter" />
                <field name="public_categ_id" placeholder="Overall" />
                <field name="target_type" optional="hide" />
                <field name="currency_id" column_invisible="1" />
                <field name="target_value" />
                <field name="target_ytd" />
                <field name="purchase_amount" optional="show" />
                <field name="purchase_qty" optional="hide" />
                <field name="purchase_ytd" />
                <field name="achieved_pct" widget="progressbar" options="{'overflow_class': 'bg-success'}" />
                <field name="remaining" />
                <field name="sale_amount" optional="show" />
                <field name="sale_qty" optional="hide" />
                <field name="sale_ytd" optional="show" />
                <button
                    name="action_view_purchases"
                    type="object"
                    icon="fa-shopping-cart"
                    title="Vendor bill lines"
                    groups="account.group_account_readonly,account.group_account_invoice"
                />
                <button
                    name="action_view_sales"
                    type="object"
                    icon="fa-line-chart"
                    title="Sales"
                    groups="deltatech_sale_margin.group_sale_margin,sales_team.group_sale_manager"
                />
            </list>
        </field>
    </record>

    <record id="view_purchase_target_line_search" model="ir.ui.view">
        <field name="name">purchase.target.line.search</field>
        <field name="model">purchase.target.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="manufacturer_id" />
                <field name="public_categ_id" />
                <field name="year" />
                <filter
                    name="current_year"
                    string="Current Year"
                    domain="[('year', '=', context_today().year)]"
                />
                <separator />
                <filter name="q1" string="Q1" domain="[('quarter', '=', '1')]" />
                <filter name="q2" string="Q2" domain="[('quarter', '=', '2')]" />
                <filter name="q3" string="Q3" domain="[('quarter', '=', '3')]" />
                <filter name="q4" string="Q4" domain="[('quarter', '=', '4')]" />
                <separator />
                <filter name="overall" string="Overall" domain="[('public_categ_id', '=', False)]" />
                <filter name="by_category" string="Per Category" domain="[('public_categ_id', '!=', False)]" />
                <group>
                    <filter name="group_manufacturer" string="Manufacturer" context="{'group_by': 'manufacturer_id'}" />
                    <filter name="group_quarter" string="Quarter" context="{'group_by': 'quarter'}" />
                    <filter name="group_category" string="Category" context="{'group_by': 'public_categ_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_target_line" model="ir.actions.act_window">
        <field name="name">Achieved vs Target</field>
        <field name="res_model">purchase.target.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_current_year': 1, 'search_default_group_manufacturer': 1}</field>
    </record>

    <!-- the bill lines behind an achieved figure: no journal panel nor attachment preview -->
    <record id="view_move_line_purchase_target_list" model="ir.ui.view">
        <field name="name">account.move.line.purchase.target.list</field>
        <field name="model">account.move.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date" />
                <field name="move_id" string="Bill" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="price_unit" />
                <field name="company_currency_id" column_invisible="1" />
                <field name="balance" string="Amount" sum="Total" />
            </list>
        </field>
    </record>

    <record id="view_move_line_purchase_target_search" model="ir.ui.view">
        <field name="name">account.move.line.purchase.target.search</field>
        <field name="model">account.move.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id" />
                <field name="partner_id" />
                <field name="product_id" />
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}" />
                    <filter name="group_move" string="Bill" context="{'group_by': 'move_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- the same vendor bills, pivoted product x vendor on the average price -->
    <record id="action_vendor_cost_compare" model="ir.actions.act_window">
        <field name="name">Vendor Cost Comparison</field>
        <field name="res_model">account.invoice.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="account.view_account_invoice_report_search" />
        <field
            name="context"
        >{'search_default_supplier': 1, 'search_default_current': 1, 'pivot_row_groupby': ['product_id'], 'pivot_column_groupby': ['partner_id'], 'pivot_measures': ['price_average']}</field>
    </record>

</odoo>
