<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_purchase_order_search" model="ir.ui.view">
        <field name="name">purchase.report.search</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_search" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="manufacturer_id" />
            </field>
            <filter name="group_partner_id" position="after">
                <filter name="group_manufacturer" string="Manufacturer" context="{'group_by': 'manufacturer_id'}" />
            </filter>
        </field>
    </record>

</odoo>
