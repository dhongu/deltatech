<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="view_location_generic" name="Warehouse Map - Location">
        <t t-call="web.layout">
            <t t-set="title">Warehouse Map</t>
            <div class="o_web_client" style="padding:16px;">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <t t-if="location and location.location_id">
                        <a
                            t-att-href="'/deltatech/warehouse_map/location/%d' % location.location_id.id"
                            class="btn btn-secondary"
                        >&#8592; Back
                        </a>
                    </t>


                    <!-- Right aligned Close button -->
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <a
                            href="#"
                            class="btn btn-outline-secondary"
                            t-attf-onclick="if (window.opener) { window.close(); } else { window.location.href = '/web'; } return false;"
                        >Close
                        </a>
                    </div>
                    <h1 class="m-0">
                        <span
                            t-esc="location and (location.complete_name or location.display_name) or 'Warehouse Map'"
                        />
                    </h1>
                </div>
                <t t-if="not location.child_ids">
                    <!-- Leaf location: show its own progress bar and the stock inside this cell -->
                    <div class="mb-3">
                        <t t-set="ratio" t-value="(location.occupancy_ratio or 0.0) * 100" />
                        <t
                            t-set="bar_class"
                            t-value="'bg-success' if ratio &lt; 60 else ('bg-warning' if ratio &lt; 90 else 'bg-danger')"
                        />
                        <div class="dw-row" style="border-bottom:0; padding-left:0; padding-right:0;">
                            <div class="dw-name">
                                <span t-esc="location.name" />
                                <span class="dw-count">
                                    <t t-esc="'%s/%s' % (location.current_products or 0, location.max_products or 0)" />
                                </span>
                            </div>
                            <div class="dw-bar">
                                <div
                                    class="dw-fill"
                                    style="width:100%; position:relative; background:#f8f9fa; opacity:1;"
                                />
                                <div
                                    class="dw-progress"
                                    t-att-class="bar_class"
                                    t-attf-style="width: {{ '%.0f' % ratio }}%;"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Stock table for this leaf location -->
                    <div>
                        <h3 style="font-size:16px; margin: 8px 0;">Stock in this location</h3>
                        <t t-if="quants and quants">
                            <table class="table table-sm table-striped" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Lot/Serial</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Reserved</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="quants" t-as="q">
                                        <tr>
                                            <td><span t-esc="q.product_id.display_name" /></td>
                                            <td><span t-esc="(q.lot_id and q.lot_id.name) or ''" /></td>
                                            <td class="text-end"><span t-esc="q.quantity" /></td>
                                            <td class="text-end"><span t-esc="q.reserved_quantity" /></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="not quants or not quants">
                            <div class="alert alert-info">No stock in this location.</div>
                        </t>
                    </div>
                </t>

                <!-- CSS minimal pentru layout fără dependență pe Bootstrap -->
                <style>
                    .dw-row { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-bottom: 1px solid #e9ecef; }
                    .dw-name { flex: 0 0 auto; min-width: 110px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    .dw-count { color: #6c757d; font-size: 12px; margin-left: 8px; }
                    /* Cresc înălțimea celulelor/segmentelor */
                    .dw-bar { flex: 1 1 auto; overflow: hidden; height: 48px; border-radius: 4px; background: #e9ecef; display: flex; align-items: stretch; }
                    .dw-seg { display: block; height: 100%; position: relative; text-decoration: none; box-sizing: border-box; border-right: 1px solid rgba(0,0,0,.12); border-left: 1px solid rgba(255,255,255,.25); min-width: 1px; background:#f8f9fa; }
                    .dw-bar .dw-seg:last-child { border-right: 0; }
                    .dw-fill { width: 100%; height: 100%; opacity: .25; background:#000; }
                    /* internal progress (real fill) */
                    .dw-progress { position:absolute; left:0; top:0; bottom:0; width:0; opacity:1; }
                    .bg-success { background: #198754; }
                    .bg-warning { background: #ffc107; }
                    .bg-danger { background: #dc3545; }
                    /* Etichetă pe 2 linii în celule (nume pe rândul 1, ocupare pe rândul 2) */
                    .dw-label { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; pointer-events: none; text-align: center; white-space: normal; color: #fff; text-shadow: 0 0 3px rgba(0,0,0,.9), 0 0 6px rgba(0,0,0,.7); z-index:2; }
                    .dw-label .line1 { background: rgba(0,0,0,.45); padding: 0 6px; border-radius: 3px; line-height: 1.2; font-weight: 700; font-size: 13px; }
                    .dw-label .line2 { background: rgba(0,0,0,.45); padding: 0 6px; border-radius: 3px; line-height: 1.2; font-weight: 600; font-size: 12px; }
                    .dw-seg.bg-warning .dw-label { color: #111; text-shadow: 0 1px 1px rgba(255,255,255,.85), 0 0 1px rgba(255,255,255,.7); }
                    .dw-seg.bg-warning .dw-label .line1, .dw-seg.bg-warning .dw-label .line2 { background: rgba(255,255,255,.85); }
                    .dw-seg.bg-success .dw-label, .dw-seg.bg-danger .dw-label { color: #fff; }
                </style>

                <t t-if="location.child_ids">
                    <t t-foreach="location.child_ids" t-as="child">
                        <div class="dw-row">
                            <div class="dw-name">
                                <a t-att-href="'/deltatech/warehouse_map/location/%d' % child.id"><t
                                        t-esc="child.name"
                                    /></a>
                                <span class="dw-count">
                                    <t t-set="maxp" t-value="child.max_products or 0" />
                                    <t t-set="curr" t-value="child.current_products or 0" />
                                    <t t-esc="'%s/%s' % (curr, maxp)" />
                                </span>
                            </div>
                            <div class="dw-bar">
                                <t t-if="child.child_ids">
                                    <!-- Segmente egale pentru fiecare sub-locație (fără ponderare după capacitate) -->
                                    <t t-foreach="child.child_ids" t-as="gc">
                                        <t t-set="grat" t-value="(gc.occupancy_ratio or 0.0) * 100" />
                                        <t
                                            t-set="gclass"
                                            t-value="'bg-success' if grat &lt; 60 else ('bg-warning' if grat &lt; 90 else 'bg-danger')"
                                        />
                                        <a
                                            t-attf-href="/web#action=stock.location_open_quants&amp;active_id={{ gc.id }}"
                                            t-att-class="'dw-seg ' + gclass"
                                            style="flex: 1 1 0%; border-top: 1px solid rgba(0,0,0,.1); border-bottom: 1px solid rgba(0,0,0,.1);"
                                            t-att-title="'Open quants for %s' % gc.display_name"
                                        >
                                            <!-- background base -->
                                            <div class="dw-fill" />
                                            <!-- inner progress bar showing occupancy percentage -->
                                            <t t-set="grat" t-value="(gc.occupancy_ratio or 0.0) * 100" />
                                            <div
                                                class="dw-progress"
                                                t-att-class="gclass"
                                                t-attf-style="width: {{ '%.0f' % grat }}%;"
                                            />
                                            <div class="dw-label">
                                                <span class="line1"><t t-esc="gc.name" /></span>
                                                <span class="line2">
                                                    <t
                                                        t-if="gc.max_products"
                                                        t-esc="'%s/%s' % (gc.current_products or 0, gc.max_products or 0)"
                                                    />
                                                    <t
                                                        t-if="not gc.max_products"
                                                        t-esc="'%s' % (gc.current_products or 0)"
                                                    />
                                                </span>
                                            </div>
                                        </a>
                                    </t>
                                </t>
                                <t t-if="not child.child_ids">
                                    <t t-set="ratio" t-value="(child.occupancy_ratio or 0.0) * 100" />
                                    <t
                                        t-set="bar_class"
                                        t-value="'bg-success' if ratio &lt; 60 else ('bg-warning' if ratio &lt; 90 else 'bg-danger')"
                                    />
                                    <div
                                        class="dw-fill"
                                        style="width:100%; position:relative; background:#f8f9fa; opacity:1;"
                                    >
                                        <div
                                            class="dw-progress"
                                            t-att-class="bar_class"
                                            t-attf-style="width: {{ '%.0f' % ratio }}%;"
                                        />
                                        <div class="dw-label">
                                            <span class="line1"><t t-esc="child.name" /></span>
                                            <span class="line2"><t
                                                    t-esc="'%s/%s' % (child.current_products or 0, child.max_products or 0)"
                                                /></span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>



            </div>
        </t>
    </template>

</odoo>
