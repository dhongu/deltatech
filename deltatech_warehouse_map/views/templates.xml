<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="view_location_generic" name="Warehouse Map - Location">
        <t t-call="web.layout">
            <t t-set="title">Warehouse Map - <t t-esc="location.name" /></t>

            <style>
                .o_map_container { padding: 20px; background-color: #ffffff; min-height: 100vh; font-family: sans-serif; }
                .dw-row { display: flex; align-items: center; gap: 16px; padding: 10px 0; border-bottom: 1px solid #eee; }

                /* Panoul lateral stânga */
                .dw-name-section { flex: 0 0 160px; min-width: 160px; }
                .dw-location-link { font-weight: 700; color: #008784; text-decoration: none; font-size: 14px; display: block; }

                /* Containerul principal al barei */
                .dw-bar-container {
                    flex: 1; height: 65px; background: #f0f2f5;
                    border-radius: 4px; display: flex; overflow: hidden;
                    border: 1px solid #ccc;
                }

                /* Segmente egale */
                .dw-seg {
                    flex: 1 1 0%; position: relative; border-right: 1px solid rgba(0,0,0,0.1);
                    text-decoration: none !important; transition: all 0.2s;
                    border: 1px solid #ccc;
                }
                .dw-seg:last-child { border-right: none; }
                .dw-seg:hover { filter: brightness(0.9); z-index: 5; }

                /* Fill-ul de progres */
                .dw-fill-bg { position: absolute; inset: 0; opacity: 0.1; }
                .dw-progress-indicator { position: absolute; left: 0; bottom: 0; top: 0; }

                /* Eticheta cu 3 linii */
                .dw-label {
                    position: absolute; inset: 0; display: flex; flex-direction: column;
                    align-items: center; justify-content: center; z-index: 5; pointer-events: none;
                    gap: 1px;
                }
                .label-line {
                    background: rgba(255,255,255,0.8); padding: 1px 5px; border-radius: 3px;
                    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90%;
                }
                .ln-name { font-size: 11px; font-weight: 800; color: #000; text-transform: uppercase; }
                .ln-pct { font-size: 10px; font-weight: 700; color: #333; }
                .ln-qty { font-size: 10px; font-weight: 600; color: #555; border: 1px solid rgba(0,0,0,0.1); }

                /* Culori Status */
                .st-success { background-color: #28a745 !important; }
                .st-warning { background-color: #ffc107 !important; }
                .st-danger { background-color: #dc3545 !important; }

                /* Tabel Stoc Leaf */
                .stock-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
                .stock-table th { background: #f8f9fa; padding: 8px; border-bottom: 2px solid #dee2e6; text-align: left; font-size: 12px; }
                .stock-table td { padding: 8px; border-bottom: 1px solid #eee; font-size: 13px; }
            </style>

            <div class="o_map_container">
                <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                    <t t-if="location and location.location_id">
                        <a
                            t-att-href="'/deltatech/warehouse_map/location/%d' % location.location_id.id"
                            class="btn btn-sm btn-secondary me-3 text-white"
                        >← Înapoi</a>
                    </t>
                    <h2 class="m-0 h4 text-dark"><t t-esc="location.display_name" /></h2>
                    <div class="ms-auto">
                        <a
                            href="#"
                            class="btn btn-sm btn-outline-secondary"
                            t-attf-onclick="if (window.opener) { window.close(); } else { window.location.href = '/web'; } return false;"
                        >Închide</a>
                    </div>
                </div>

                <t t-if="location.child_ids">
                    <t t-foreach="location.child_ids" t-as="child">
                        <div class="dw-row">
                            <div class="dw-name-section">
                                <a
                                    class="dw-location-link"
                                    t-att-href="'/deltatech/warehouse_map/location/%d' % child.id"
                                >
                                    <t t-esc="child.name" />
                                </a>
                                <small class="text-muted">Total: <t t-esc="child.current_products" /> / <t
                                        t-esc="child.max_products or '∞'"
                                    /></small>
                            </div>

                            <div class="dw-bar-container">
                                <t t-if="child.child_ids">
                                    <t t-foreach="child.child_ids" t-as="gc">
                                        <t t-set="grat" t-value="(gc.occupancy_ratio or 0.0) * 100" />
                                        <t
                                            t-set="st_class"
                                            t-value="'st-success' if grat &lt; 60 else ('st-warning' if grat &lt; 90 else 'st-danger')"
                                        />

                                        <a
                                            t-attf-href="/web#action=stock.location_open_quants&amp;active_id={{ gc.id }}"
                                            class="dw-seg"
                                            t-att-title="gc.display_name"
                                        >

                                            <div t-attf-class="dw-fill-bg {{ st_class }}" />
                                            <div
                                                t-attf-class="dw-progress-indicator {{ st_class }}"
                                                t-attf-style="width: {{ '%.0f' % grat }}%;"
                                            />

                                            <div class="dw-label">
                                                <span class="label-line ln-name"><t t-esc="gc.name" /></span>
                                                <span class="label-line ln-pct"><t t-esc="'%.0f' % grat" />%</span>
                                                <span class="label-line ln-qty">
                                                    <t t-esc="gc.current_products or 0" /> / <t
                                                        t-esc="gc.max_products or '∞'"
                                                    />
                                                </span>
                                            </div>
                                        </a>
                                    </t>
                                </t>

                                <t t-if="not child.child_ids">
                                    <t t-set="grat" t-value="(child.occupancy_ratio or 0.0) * 100" />
                                    <t
                                        t-set="st_class"
                                        t-value="'st-success' if grat &lt; 60 else ('st-warning' if grat &lt; 90 else 'st-danger')"
                                    />
                                    <div class="dw-seg" style="border:none;">
                                        <div t-attf-class="dw-fill-bg {{ st_class }}" />
                                        <div
                                            t-attf-class="dw-progress-indicator {{ st_class }}"
                                            t-attf-style="width: {{ '%.0f' % grat }}%;"
                                        />
                                        <div class="dw-label">
                                            <span class="label-line ln-name"><t t-esc="child.name" /></span>
                                            <span class="label-line ln-pct"><t t-esc="'%.0f' % grat" />%</span>
                                            <span class="label-line ln-qty">
                                                <t t-esc="child.current_products or 0" /> / <t
                                                    t-esc="child.max_products or 0"
                                                />
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>

                <t t-if="not location.child_ids">
                    <div class="mt-4 border rounded p-3">
                        <h6 class="text-uppercase fw-bold text-muted mb-3">Produse în această locație</h6>
                        <table class="stock-table">
                            <thead>
                                <tr>
                                    <th>Produs</th>
                                    <th>Lot/Serial</th>
                                    <th class="text-end">Cantitate</th>
                                    <th class="text-end">Rezervat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="quants" t-as="q">
                                    <tr>
                                        <td><strong><t t-esc="q.product_id.display_name" /></strong></td>
                                        <td><t t-esc="q.lot_id.name or '-'" /></td>
                                        <td class="text-end text-success fw-bold"><t t-esc="q.quantity" /></td>
                                        <td class="text-end text-muted"><t t-esc="q.reserved_quantity" /></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
