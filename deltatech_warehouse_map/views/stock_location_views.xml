<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Button in list (tree) view to open the map for the selected location -->
    <record id="view_stock_location_tree_inherit_deltatech_map" model="ir.ui.view">
        <field name="name">stock.location.tree.deltatech.map</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <button name="action_open_map" type="object" string="Map" class="btn btn-secondary btn-sm" />
            </xpath>
        </field>
    </record>

    <!-- Smart button on form to open the map -->
    <record id="view_stock_location_form_inherit_deltatech_map" model="ir.ui.view">
        <field name="name">stock.location.form.deltatech.map</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_map" type="object" class="oe_stat_button" icon="grid_view" string="Open Map" />
            </xpath>
        </field>
    </record>

    <!-- Stock (quants) of a location and its sublocations, opened from the map -->
    <record id="action_location_open_quants" model="ir.actions.act_window">
        <field name="name">Current Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="stock.view_stock_quant_tree" />
        <field name="search_view_id" ref="stock.quant_search_view" />
        <field name="domain">[('location_id', 'child_of', active_id)]</field>
        <field name="context">{'search_default_productgroup': 1, 'create': False}</field>
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_user'))]" />
    </record>
</odoo>
