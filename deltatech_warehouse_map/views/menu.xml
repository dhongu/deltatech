<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Action: open the warehouse map UI (backend) -->
        <record id="action_deltatech_warehouse_map" model="ir.actions.act_url">
            <field name="name">Warehouse Map</field>
            <field name="url">/deltatech/warehouse_map</field>
            <field name="target">self</field>
        </record>

        <!-- Menu item under Inventory -->
        <menuitem
            id="menu_deltatech_warehouse_map"
            name="Warehouse Map"
            parent="stock.menu_stock_root"
            action="action_deltatech_warehouse_map"
            sequence="95"
        />
    </data>
</odoo>
