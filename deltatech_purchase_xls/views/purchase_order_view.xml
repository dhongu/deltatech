<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Enhanced Purchase Order Form with vendor pricelist integration -->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.enhanced</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="show_order_lines" type="object" class="btn oe_stat_button btn-outline-secondary flex-grow-1 flex-lg-grow-0" icon="fa-list-ul">
                    <span>Linii Comandă</span>
                </button>
            </div>
        </field>
    </record>

    <!-- Enhanced Purchase Order Lines Tree View -->
    <record id="purchase_order_line_tree_enhanced" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.enhanced</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" import="1" export_xlsx="1">
                <field name="product_id"
                       context="{'partner_id': parent.partner_id, 'quantity': product_qty, 'uom': product_uom, 'company_id': parent.company_id}"
                       domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                       options="{'no_create': True}"
                />
                <field name="partner_ref" string="Vendor Code"/>
                <field name="name" string="Description"/>
                <field name="product_qty"/>
                <field name="product_uom" string="UoM" optional="show"/>
                <field name="product_uom_category_id" invisible="1"/>
                <field name="date_planned" optional="show"/>
                <field name="price_unit"/>
                <field name="price_subtotal" widget="monetary"/>
                <field name="taxes_id" widget="many2many_tags" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Action for enhanced purchase order lines -->
    <record id="action_purchase_order_line_enhanced" model="ir.actions.act_window">
        <field name="name">Purchase Order Lines - Enhanced</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="purchase_order_line_tree_enhanced"/>
        <field name="context">{
            'search_default_order_id': active_id,
            'default_order_id': active_id,
        }</field>
        <field name="domain">[('order_id', '=', active_id)]</field>
    </record>

</odoo>
