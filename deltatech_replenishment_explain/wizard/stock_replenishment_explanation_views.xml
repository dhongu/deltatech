<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_replenishment_explanation_form" model="ir.ui.view">
        <field name="name">stock.replenishment.explanation.form</field>
        <field name="model">stock.replenishment.explanation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="explanation_html" readonly="1" nolabel="1" />
                </sheet>
                <footer>
                    <button
                        name="action_open_forecast_report"
                        string="Open Forecast Report"
                        type="object"
                        class="btn-secondary"
                    />
                    <button string="Close" special="cancel" class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
