<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="categorie_link" inherit_id="website_sale.categorie_link">
        <xpath expr="//a" position="attributes">
            <attribute name="t-attf-onclick">location.href='#{keep(c.website_url)}';</attribute>
        </xpath>
    </template>

    <!--
        Render only the branch the visitor is looking at.

        The collapsible sidebar already computes `isOpen` and then renders every
        descendant anyway, hidden behind a `collapse` class. On a large catalog
        that is the dominant cost of the whole listing page: measured on an 18.0
        shop with 1222 public categories, the tree accounted for 0.59s of a 0.82s
        response and 1.03 MB of the 2.22 MB of HTML — markup the visitor never
        sees until they expand a branch.

        Collapsed branches now ship an empty `<ul>` carrying the category id; the
        `lazy_categories` interaction fills it from `/shop/category_children/<id>`
        on first expand, so the rendered result is identical.

        While a search is active the tree is already filtered down to matching
        categories, so it stays fully rendered — cheap, and it keeps the search
        behaviour untouched.
    -->
    <template id="lazy_collapse_categories_recursive" inherit_id="website_sale.option_collapse_categories_recursive">
        <xpath expr="//ul" position="attributes">
            <attribute name="t-att-data-lazy-category">not isOpen and not search and c.id or None</attribute>
        </xpath>
        <!--
            19.0 iterates `c.child_id` rather than `children` (core keeps the
            original recordset to preserve `_prefetch_ids`) and filters inside the
            loop, so the xpath differs from the 18.0 version of this override.

            QWeb evaluates `t-foreach` before `t-if`, so the condition is checked
            once per child rather than once for the branch. That is harmless here
            (`isOpen` comes from an enclosing `t-set`, so it does not vary inside
            the loop) and it keeps this an attribute-only override: the recursive
            `t-call` stays core's, and upstream changes to it are not shadowed.
        -->
        <xpath expr="//t[@t-foreach='c.child_id']" position="attributes">
            <attribute name="t-if">isOpen or search</attribute>
        </xpath>
    </template>

    <!-- Fragment returned by /shop/category_children/<id>: the direct children
         of one collapsed branch, rendered exactly as the sidebar would. -->
    <template id="lazy_categories_children" name="Lazy Category Children">
        <t t-foreach="children" t-as="c">
            <t t-call="website_sale.option_collapse_categories_recursive" />
        </t>
    </template>

</odoo>
