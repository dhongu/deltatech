<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_invoice_form_custom_currency_rate" model="ir.ui.view">
        <field name="name">Invoice custom currency rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="currency_rate_custom" invisible="company_currency_id==currency_id" />
            </xpath>
        </field>
    </record>
</odoo>
