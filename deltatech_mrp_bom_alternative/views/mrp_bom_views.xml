<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp.bom.form.alternative</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='uom_id']" position="after">
                <field name="alternative_policy" optional="show" />
                <field name="alternative_count" column_invisible="True" />
                <button
                    name="action_open_alternatives"
                    type="object"
                    icon="swap_horiz"
                    title="Alternatives"
                    aria-label="Alternatives"
                    class="text-primary"
                    invisible="not id or not alternative_count"
                />
                <button
                    name="action_open_alternatives"
                    type="object"
                    icon="swap_horiz"
                    title="Alternatives"
                    aria-label="Alternatives"
                    class="text-muted"
                    invisible="not id or alternative_count"
                />
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_line_view_form_alternative" model="ir.ui.view">
        <field name="name">mrp.bom.line.form.alternative</field>
        <field name="model">mrp.bom.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Alternative Components">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="1" />
                            <label for="product_qty" string="Quantity" />
                            <div class="o_row">
                                <field name="product_qty" readonly="1" />
                                <field name="uom_id" readonly="1" groups="uom.group_uom" />
                            </div>
                        </group>
                        <group>
                            <field name="alternative_policy" widget="radio" />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>
                    <field name="alternative_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="product_id" />
                            <field name="product_qty" />
                            <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom" />
                            <field name="date_start" optional="show" />
                            <field name="date_end" optional="show" />
                            <field name="note" />
                            <field name="company_id" column_invisible="True" />
                        </list>
                    </field>
                    <div class="text-muted">
                        The quantity of an alternative replaces the quantity of the original component shown above.
                    </div>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save" />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
