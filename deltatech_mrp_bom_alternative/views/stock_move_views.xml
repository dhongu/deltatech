<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_move_view_list_substitution" model="ir.ui.view">
        <field name="name">stock.move.list.substitution</field>
        <field name="model">stock.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date" />
                <field name="raw_material_production_id" string="Manufacturing Order" />
                <field name="original_product_id" />
                <field name="product_id" string="Consumed Instead" />
                <field name="product_uom_qty" string="Quantity" sum="Total" />
                <field name="product_uom" groups="uom.group_uom" />
                <field name="substitution_reason" />
                <field name="state" widget="badge" />
                <field name="company_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="stock_move_view_search_substitution" model="ir.ui.view">
        <field name="name">stock.move.search.substitution</field>
        <field name="model">stock.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="original_product_id" />
                <field name="product_id" string="Consumed Instead" />
                <field name="raw_material_production_id" string="Manufacturing Order" />
                <filter name="manual" string="Manual" domain="[('substitution_reason', '=', 'manual')]" />
                <filter name="auto" string="Automatic" domain="[('substitution_reason', '=', 'auto')]" />
                <separator />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <filter name="date" string="Date" date="date" />
                <group>
                    <filter name="group_original" string="Replaced Component" context="{'group_by': 'original_product_id'}" />
                    <filter name="group_product" string="Consumed Instead" context="{'group_by': 'product_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="stock_move_action_substitution" model="ir.actions.act_window">
        <field name="name">Component Substitutions</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('original_product_id', '!=', False), ('state', '!=', 'cancel')]</field>
        <field name="search_view_id" ref="stock_move_view_search_substitution" />
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'list', 'view_id': ref('stock_move_view_list_substitution')})]"
        />
    </record>

    <menuitem
        id="menu_stock_move_substitution"
        action="stock_move_action_substitution"
        parent="mrp.menu_mrp_reporting"
        groups="mrp.group_mrp_user"
        sequence="30"
    />
</odoo>
