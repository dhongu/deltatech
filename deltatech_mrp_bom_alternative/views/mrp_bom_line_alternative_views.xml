<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_bom_line_alternative_view_list" model="ir.ui.view">
        <field name="name">mrp.bom.line.alternative.list</field>
        <field name="model">mrp.bom.line.alternative</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="bom_id" />
                <field name="bom_line_id" />
                <field name="original_product_id" optional="show" />
                <field name="original_qty" optional="hide" />
                <field name="original_uom_id" optional="hide" groups="uom.group_uom" />
                <field name="sequence" widget="handle" />
                <field name="product_id" />
                <field name="product_qty" />
                <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom" />
                <field name="date_start" optional="show" />
                <field name="date_end" optional="show" />
                <field name="note" optional="show" />
                <field name="company_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="mrp_bom_line_alternative_view_search" model="ir.ui.view">
        <field name="name">mrp.bom.line.alternative.search</field>
        <field name="model">mrp.bom.line.alternative</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
                <field name="original_product_id" />
                <field name="bom_id" />
                <group>
                    <filter name="group_bom" string="Bill of Materials" context="{'group_by': 'bom_id'}" />
                    <filter name="group_product" string="Alternative Component" context="{'group_by': 'product_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="mrp_bom_line_alternative_action" model="ir.actions.act_window">
        <field name="name">BoM Alternatives</field>
        <field name="res_model">mrp.bom.line.alternative</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No alternative component yet</p>
            <p>Alternatives are added on the components of a bill of materials, with the exchange button.</p>
        </field>
    </record>

    <menuitem
        id="menu_mrp_bom_line_alternative"
        action="mrp_bom_line_alternative_action"
        parent="mrp.menu_mrp_bom"
        groups="mrp.group_mrp_manager"
        sequence="15"
    />
</odoo>
