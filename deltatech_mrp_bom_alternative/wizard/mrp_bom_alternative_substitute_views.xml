<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_bom_alternative_substitute_view_form" model="ir.ui.view">
        <field name="name">mrp.bom.alternative.substitute.form</field>
        <field name="model">mrp.bom.alternative.substitute</field>
        <field name="arch" type="xml">
            <form string="Substitute Component">
                <group>
                    <group>
                        <field name="move_id" invisible="1" />
                        <field name="allowed_alternative_ids" invisible="1" />
                        <field name="production_id" />
                        <field name="product_id" />
                        <label for="product_uom_qty" />
                        <div class="o_row">
                            <field name="product_uom_qty" />
                            <field name="uom_id" groups="uom.group_uom" />
                        </div>
                        <field name="reserved_qty" />
                    </group>
                    <group>
                        <field name="alternative_id" options="{'no_create': True, 'no_open': True}" />
                        <label for="qty" />
                        <div class="o_row">
                            <field name="qty" />
                            <field name="uom_id" groups="uom.group_uom" />
                        </div>
                        <label for="alternative_qty" invisible="not alternative_id" />
                        <div class="o_row" invisible="not alternative_id">
                            <field name="alternative_qty" />
                            <field name="alternative_uom_id" groups="uom.group_uom" />
                        </div>
                        <field name="max_qty" invisible="1" />
                    </group>
                </group>
                <field name="availability_html" nolabel="1" readonly="1" />
                <footer>
                    <button name="action_substitute" string="Substitute" type="object" class="btn-primary" data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
