#. module: deltatech_website_vat_validation
msgid ""
"Enter the company VAT number (digits only, 2-10 characters). Example: "
"12345678 or RO12345678."
msgstr ""
"Introdu CUI-ul companiei (doar cifre, 2-10 caractere). Exemplu: 12345678 sau"
" RO12345678."

