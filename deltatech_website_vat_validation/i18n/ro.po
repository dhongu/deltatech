#. module: deltatech_website_vat_validation
#. python-format
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid "The VAT number is not valid according to ANAF"
msgstr "Codul TVA nu este valid conform ANAF"

#. module: deltatech_website_vat_validation
#. python-format
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid "The VAT number must contain only digits (after the country code)"
msgstr "Codul TVA trebuie să conțină doar cifre (după codul țării)"

#. module: deltatech_website_vat_validation
#. odoo-python
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid ""
"The VAT number %(vat)s could not be checked at ANAF (service unavailable). "
"Please check the customer details."
msgstr ""
"Codul fiscal %(vat)s nu a putut fi verificat la ANAF (serviciu indisponibil). "
"Verificați datele clientului."

#. module: deltatech_website_vat_validation
#. odoo-python
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid ""
"This looks like a personal numeric code (CNP). This field is for the tax "
"code (CUI) of a company; if you buy as an individual, leave it empty."
msgstr ""
"Acesta pare a fi un cod numeric personal (CNP). Câmpul este pentru codul "
"fiscal (CUI) al unei firme; dacă cumpărați ca persoană fizică, lăsați-l gol."

#. module: deltatech_website_vat_validation
#. odoo-python
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid ""
"A company with this tax code already has an account with us. To order on "
"its behalf, ask a colleague who has access to add you, or contact us."
msgstr ""
"Firma cu acest cod fiscal are deja cont la noi. Pentru a comanda în numele "
"ei, cereți unui coleg care are acces să vă adauge sau contactați-ne."

#. module: deltatech_website_vat_validation
#. odoo-python
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid ""
"A company with this tax code already has an account with us. To order on "
"its behalf, ask a colleague who has access to add you, or send an access "
"request from %(url)s."
msgstr ""
"Firma cu acest cod fiscal are deja cont la noi. Pentru a comanda în numele "
"ei, cereți unui coleg care are acces să vă adauge sau trimiteți o cerere de "
"acces de la %(url)s."

#. module: deltatech_website_vat_validation
#. odoo-python
#: code:addons/deltatech_website_vat_validation/controllers/website_sale.py:0
msgid ""
"This e-mail address belongs to another account. Log in with that account or "
"use another address."
msgstr ""
"Această adresă de e-mail aparține altui cont. Autentificați-vă cu acel cont "
"sau folosiți altă adresă."
