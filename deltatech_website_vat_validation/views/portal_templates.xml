<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit portal details FIELDS form pentru validare CUI în România -->
    <!-- Câmpurile sunt în portal.portal_my_details_fields, nu în portal_my_details -->
    <template id="portal_my_details_vat_required" inherit_id="portal.portal_my_details_fields">
        
        <!-- Adăugăm card sugestiv pentru secțiunea Date Companie (portal) -->
        <!-- Găsim input-ul pentru company_name și adăugăm înainte de părintele lui -->
        <xpath expr="//input[@name='company_name']" position="before">
            <t t-if="partner.country_id.code == 'RO' or not partner.country_id">
                <div class="clearfix"/>
                <div class="col-12">
                    <div class="o_company_data_section p-3 mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa fa-building o_company_header_icon me-2"></i>
                            <strong class="text-muted">Date Companie (Opțional)</strong>
                        </div>
                        <small class="form-text text-muted o_company_help_text">
                            <i class="fa fa-info-circle"></i>
                            Completați doar dacă doriți factură pe firmă. Ambele câmpuri devin obligatorii dacă completați unul dintre ele.
                        </small>
                    </div>
                </div>
            </t>
        </xpath>
        
        <!-- Adăugăm placeholder și clase pentru Nume Companie -->
        <xpath expr="//input[@name='company_name']" position="attributes">
            <attribute name="placeholder">Ex: SC EXAMPLE SRL</attribute>
            <attribute name="class" add="o_company_name_input" separator=" "/>
            <attribute name="id">company_name</attribute>
        </xpath>
        
        <!-- Adăugăm validare, placeholder și clase pentru CUI -->
        <xpath expr="//input[@name='vat']" position="attributes">
            <attribute name="placeholder">Ex: 12345678 sau RO12345678</attribute>
            <attribute name="t-att-pattern">'(RO)?[0-9]{2,10}' if partner.country_id.code == 'RO' or not partner.country_id else None</attribute>
            <attribute name="t-att-title">'CUI-ul trebuie să conțină doar cifre (2-10 cifre, opțional prefixat cu RO)' if partner.country_id.code == 'RO' or not partner.country_id else None</attribute>
            <attribute name="class" add="vat-input o_vat_input" separator=" "/>
            <attribute name="id">vat</attribute>
        </xpath>
        
        <!-- Adăugăm help text detaliat pentru CUI în portal -->
        <xpath expr="//input[@name='vat']" position="after">
            <small t-if="partner.country_id.code == 'RO' or not partner.country_id" class="form-text text-muted o_company_help_text mt-1">
                <i class="fa fa-info-circle text-info"></i>
                Introduceți CUI-ul companiei (doar cifre, 2-10 caractere). Exemplu: <strong>12345678</strong> sau <strong>RO12345678</strong>
            </small>
        </xpath>
        
    </template>

</odoo>
