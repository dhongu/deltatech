<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Mostenire a formularului de adresa din checkout pentru validare CUI in Romania -->
    <template id="address_vat_required" inherit_id="website_sale.address">
        <!-- Afisare buton pentru facturare pe companie -->
        <xpath expr="//div[@id='company_name_div']" position="before">
            <div class="mb-2">
                <div class="form-check form-switch">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="o_invoice_company"
                        name="invoice_company"
                        data-bs-toggle="collapse"
                        data-bs-target=".o-company-collapse"
                        aria-controls="o_company_section_collapse"
                        t-att-checked="'checked' if partner_sudo.company_name or partner_sudo.vat or partner_sudo.is_company else None"
                        t-att-aria-expanded="'true' if partner_sudo.company_name or partner_sudo.vat or partner_sudo.is_company else 'false'"
                    />
                    <span class="form-check-label">Invoice to company</span>
                </div>
                <small class="form-text text-muted">
                    If you enable this option, fill in the company fields. For Romania, the VAT number can auto-fill details from ANAF.
                </small>
            </div>
        </xpath>

        <!-- Incadram sectiunea pentru date companie intr-un card sugestiv -->
        <xpath expr="//div[@id='company_name_div']" position="before">
            <!-- Card pentru date companie (doar Romania) -->
            <div t-if="country.code == 'RO'" id="o_company_section_collapse" class="o_company_data_section p-3 mb-3 o-company-collapse collapse" aria-labelledby="o_company_data_title">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa fa-building o_company_header_icon me-2" aria-hidden="true" />
                    <strong id="o_company_data_title" class="text-muted">Company Data (Optional)</strong>
                </div>
                <small class="form-text text-muted o_company_help_text">
                    <i class="fa fa-info-circle" aria-hidden="true" />
                    Fill this section only if you need an invoice on company. Both fields become mandatory if you fill one of them.
                </small>
            </div>
        </xpath>

        <!-- Activam collapse pe div-urile cimpurilor pentru a respecta toggle-ul -->
        <xpath expr="//div[@id='company_name_div']" position="attributes">
            <attribute name="class" add="collapse o-company-collapse" separator=" " />
        </xpath>
        <xpath expr="//div[@id='div_vat']" position="attributes">
            <attribute name="class" add="collapse o-company-collapse" separator=" " />
        </xpath>

        <!-- Adaugam icon langa label pentru Nume Companie -->
        <xpath expr="//div[@id='company_name_div']//label[@for='o_company_name']" position="inside">
            <t t-if="country.code == 'RO'">
                <i class="fa fa-building text-muted me-1" aria-hidden="true" />
            </t>
        </xpath>

        <!-- Adaugam icon langa label pentru CUI/VAT -->
        <xpath expr="//div[@id='div_vat']//label[@for='o_vat']" position="inside">
            <t t-if="country.code == 'RO'">
                <i class="fa fa-hashtag text-muted me-1" aria-hidden="true" />
            </t>
        </xpath>

        <!-- Setam placeholder si clase pentru Nume Companie -->
        <xpath expr="//input[@id='o_company_name']" position="attributes">
            <attribute name="placeholder">Ex: SC EXAMPLE SRL</attribute>
            <attribute name="class" add="o_company_name_input" separator=" " />
        </xpath>

        <!-- Setam validare, placeholder si clase pentru CUI -->
        <xpath expr="//input[@id='o_vat']" position="attributes">
            <attribute name="placeholder">Ex: 12345678 or RO12345678</attribute>
            <attribute name="t-att-pattern">'(RO)?[0-9]{2,10}' if country.code == 'RO' else None</attribute>
            <attribute
                name="t-att-title"
            >'The VAT number must contain digits only (2-10 digits, optionally prefixed with RO)' if country.code == 'RO' else None</attribute>
            <attribute name="class" add="vat-input o_vat_input" separator=" " />
        </xpath>

        <!-- Afisam help text pentru CUI romanesc -->
        <xpath expr="//div[@id='div_vat']" position="inside">
            <small t-if="country.code == 'RO'" class="form-text text-muted o_company_help_text mt-1">
                <i class="fa fa-info-circle text-info" aria-hidden="true" />
                Enter the company VAT number (digits only, 2-10 characters). Example: <strong
                >12345678</strong> or <strong>RO12345678</strong>.
            </small>
        </xpath>

    </template>

</odoo>
