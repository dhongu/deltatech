<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit checkout address form pentru validare CUI în România -->
    <template id="address_vat_required" inherit_id="website_sale.address">
        
        <!-- Wrap secțiunea Date Companie într-un card sugestiv -->
        <xpath expr="//div[@id='company_name_div']" position="before">
            <!-- Card header pentru secțiunea de date companie (doar pentru RO) -->
            <div t-if="country.code == 'RO'" class="o_company_data_section p-3 mb-3">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa fa-building o_company_header_icon me-2"></i>
                    <strong class="text-muted">Date Companie (Opțional)</strong>
                </div>
                <small class="form-text text-muted o_company_help_text">
                    <i class="fa fa-info-circle"></i>
                    Completați doar dacă doriți factură pe firmă. Ambele câmpuri devin obligatorii dacă completați unul dintre ele.
                </small>
            </div>
        </xpath>
        
        <!-- Îmbunătățim label-ul pentru Nume Companie -->
        <xpath expr="//div[@id='company_name_div']//label[@for='o_company_name']" position="replace">
            <label class="col-form-label" for="o_company_name">
                <t t-if="country.code == 'RO'">
                    <i class="fa fa-building text-muted me-1"></i>Nume Companie
                </t>
                <t t-else="">Company Name</t>
            </label>
        </xpath>
        
        <!-- Îmbunătățim label-ul pentru CUI/VAT -->
        <xpath expr="//div[@id='div_vat']//label[@for='o_vat']" position="replace">
            <label class="col-form-label" for="o_vat">
                <t t-if="country.code == 'RO'">
                    <i class="fa fa-hashtag text-muted me-1"></i>CUI (Cod Unic de Înregistrare)
                </t>
                <t t-else=""><t t-out="vat_label"/></t>
            </label>
        </xpath>
        
        <!-- Adăugăm placeholder și clase pentru Nume Companie -->
        <xpath expr="//input[@id='o_company_name']" position="attributes">
            <attribute name="placeholder">Ex: SC EXAMPLE SRL</attribute>
            <attribute name="class" add="o_company_name_input" separator=" "/>
        </xpath>
        
        <!-- Adăugăm validare, placeholder și clase pentru CUI -->
        <xpath expr="//input[@id='o_vat']" position="attributes">
            <attribute name="placeholder">Ex: 12345678 sau RO12345678</attribute>
            <attribute name="t-att-pattern">'(RO)?[0-9]{2,10}' if country.code == 'RO' else None</attribute>
            <attribute name="t-att-title">'CUI-ul trebuie să conțină doar cifre (2-10 cifre, opțional prefixat cu RO)' if country.code == 'RO' else None</attribute>
            <attribute name="class" add="vat-input o_vat_input" separator=" "/>
        </xpath>
        
        <!-- Adăugăm help text detaliat pentru CUI românesc -->
        <xpath expr="//div[@id='div_vat']" position="inside">
            <small t-if="country.code == 'RO'" class="form-text text-muted o_company_help_text mt-1">
                <i class="fa fa-info-circle text-info"></i>
                Introduceți CUI-ul companiei (doar cifre, 2-10 caractere). Exemplu: <strong>12345678</strong> sau <strong>RO12345678</strong>
            </small>
        </xpath>
        
    </template>

</odoo>
