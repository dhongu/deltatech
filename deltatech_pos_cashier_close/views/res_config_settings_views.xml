<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deltatech_pos_cashier_close</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='multiple_employee_session']" position="after">
                <setting
                    id="cashier_can_close"
                    help="Employees with basic rights close the register"
                    invisible="not pos_module_pos_hr"
                >
                    <field name="pos_cashier_can_close" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
