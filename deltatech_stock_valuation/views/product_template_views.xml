<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extinde vizualizarea formularului pentru product.template -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']//group[@name='accounting']" position="inside">
                <field name="product_valuation_ids">
                    <tree editable="bottom" delete="0">
                        <field
                            name="product_id"
                            domain="[('product_tmpl_id', '=', parent.id)]"
                            readonly="quantity !=0"
                        />
                        <field name="valuation_area_id" readonly="quantity !=0" />
                         <field name="account_id" readonly="quantity !=0" />
                        <field name="price" readonly="quantity !=0" />
                        <field name="quantity" sum="sum_qty" readonly="1" />
                        <field name="amount" sum="sum_amount" readonly="1" />
                        <field name="currency_id" column_invisible="1" />
                    </tree>
                </field>

            </xpath>
        </field>
    </record>



</odoo>
