<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Calculăm logo-ul raportului o singură dată, în dispecerul external_layout.
        Toate variantele de layout din Odoo 20 (standard, wave, bubble, folder,
        center, dual, lines, compact) sunt apelate prin acest template, deci
        moștenesc `report_logo`.
        Implicit folosim logo-ul firmei; dacă documentul are o echipă de vânzare
        cu logo propriu, îl folosim pe acela.
    -->
    <template id="external_layout_team_logo" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before">
            <t t-set="report_logo" t-value="company.logo"/>
            <!-- doar crm.team are logo: alte modele au team_id spre alte echipe
                 (quality.alert.team, helpdesk.team) -->
            <t t-if="o and 'team_id' in o and o.team_id._name == 'crm.team' and o.team_id.logo"
               t-set="report_logo" t-value="o.team_id.logo"/>
        </xpath>
    </template>

    <!--
        Înlocuim referința company.logo cu report_logo în fiecare variantă de layout.
        Fallback pe company.logo: unele rapoarte apelează direct o variantă
        (ex. t-call="web.external_layout_standard"), fără să treacă prin
        web.external_layout, deci fără report_logo calculat.
    -->
    <template id="external_layout_standard_team_logo" inherit_id="web.external_layout_standard">
        <xpath expr="//td[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">report_logo or company.logo</attribute>
        </xpath>
        <xpath expr="//img[@t-att-src='image_data_uri(company.logo)']" position="attributes">
            <attribute name="t-att-src">image_data_uri(report_logo or company.logo)</attribute>
        </xpath>
    </template>

    <template id="external_layout_wave_team_logo" inherit_id="web.external_layout_wave">
        <xpath expr="//img[@t-att-src='image_data_uri(company.logo)']" position="attributes">
            <attribute name="t-if">report_logo or company.logo</attribute>
            <attribute name="t-att-src">image_data_uri(report_logo or company.logo)</attribute>
        </xpath>
    </template>

    <template id="external_layout_bubble_team_logo" inherit_id="web.external_layout_bubble">
        <xpath expr="//img[@t-att-src='image_data_uri(company.logo)']" position="attributes">
            <attribute name="t-if">report_logo or company.logo</attribute>
            <attribute name="t-att-src">image_data_uri(report_logo or company.logo)</attribute>
        </xpath>
    </template>

    <template id="external_layout_folder_team_logo" inherit_id="web.external_layout_folder">
