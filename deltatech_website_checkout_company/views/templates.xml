<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Address form in the Romanian order: last name and first name, country, county, city,
        street, then email and phone. Below them, an optional billing section: a customer who
        buys as a company ticks the box and types the company name, its VAT number (CUI) and
        its registered office; the order is then invoiced to the company.
    -->
    <template id="address_form_fields" inherit_id="portal.address_form_fields" priority="100">
        <xpath expr="//div[@id='div_name']" position="replace">
            <t t-set="tb_name_parts" t-value="(partner_sudo.name or '').split(' ', 1)" />
            <div id="div_name" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_tb_lastname">Last name</label>
                <input
                    id="o_tb_lastname"
                    type="text"
                    name="tb_lastname"
                    t-att-value="tb_name_parts[0]"
                    class="form-control"
                    autocomplete="family-name"
                />
                <input type="hidden" name="name" t-att-value="partner_sudo.name" />
            </div>
            <div id="div_tb_firstname" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_tb_firstname">First name</label>
                <input
                    id="o_tb_firstname"
                    type="text"
                    name="tb_firstname"
                    t-att-value="tb_name_parts[1] if len(tb_name_parts) &gt; 1 else ''"
                    class="form-control"
                    autocomplete="given-name"
                />
            </div>
        </xpath>

        <xpath expr="//div[@id='div_tb_firstname']" position="after">
            <div class="w-100" />
            <xpath expr="//div[@id='div_country']" position="move" />
            <xpath expr="//div[@id='div_state']" position="move" />
        </xpath>

        <xpath expr="//div[@id='div_city']" position="after">
            <xpath expr="//div[@id='div_street']" position="move" />
            <xpath expr="//div[@id='div_street2']" position="move" />
        </xpath>

        <!-- The standard company name and VAT number stay only for a customer who already
             belongs to a company; the others get the billing section below. -->
        <xpath expr="//t[@name='b2b_fields']/t[@t-if='is_used_as_billing']" position="attributes">
            <attribute name="t-if">is_used_as_billing and commercial_partner.is_company</attribute>
        </xpath>

        <xpath expr="//input[@name='csrf_token']" position="before">
            <div class="w-100" />
            <xpath expr="//div[@id='div_email']" position="move" />
            <xpath expr="//div[@id='div_phone']" position="move" />
            <div
                t-if="is_used_as_billing and is_main_address and not commercial_partner.is_company"
                id="div_tb_company"
                class="col-12 mt-3"
            >
                <div class="border-top pt-3">
                    <h5 class="mb-3">
                        Billing details
                        <small class="text-muted fw-normal">(optional)</small>
                    </h5>
                    <div class="form-check mb-2">
                        <input
                            id="o_tb_company"
                            type="checkbox"
                            name="tb_company"
                            value="true"
                            class="form-check-input"
                            data-bs-toggle="collapse"
                            data-bs-target="#tb_company_fields"
                            aria-controls="tb_company_fields"
                            aria-expanded="false"
                        />
                        <label class="form-check-label" for="o_tb_company">
                            I am buying as a legal entity (company)
                        </label>
                    </div>
                    <div id="tb_company_fields" class="collapse">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <label class="col-form-label" for="o_tb_company_name">Company name</label>
                                <input
                                    id="o_tb_company_name"
                                    type="text"
                                    name="tb_company_name"
                                    class="form-control"
                                    autocomplete="organization"
                                />
                            </div>
                            <div class="col-12 mb-2">
                                <label class="col-form-label" for="o_tb_company_vat">VAT number (CUI)</label>
                                <input
                                    id="o_tb_company_vat"
                                    type="text"
                                    name="tb_company_vat"
                                    class="form-control"
                                    placeholder="RO12345678"
                                />
                            </div>
                            <div class="col-lg-6 mb-2">
                                <label class="col-form-label" for="o_tb_company_state_id">Registered office county</label>
                                <select id="o_tb_company_state_id" name="tb_company_state_id" class="form-select">
                                    <option value="">County...</option>
                                    <t
                                        t-foreach="request.env['res.country.state'].sudo().search([('country_id.code', '=', 'RO')], order='name')"
                                        t-as="tb_state"
                                    >
                                        <option t-att-value="tb_state.id" t-out="tb_state.name" />
                                    </t>
                                </select>
                            </div>
                            <div class="col-lg-6 mb-2">
                                <label class="col-form-label" for="o_tb_company_city">Registered office city</label>
                                <input id="o_tb_company_city" type="text" name="tb_company_city" class="form-control" />
                            </div>
                            <div class="col-lg-8 mb-2">
                                <label class="col-form-label" for="o_tb_company_street">Registered office address</label>
                                <input id="o_tb_company_street" type="text" name="tb_company_street" class="form-control" />
                            </div>
                            <div class="col-lg-4 mb-2">
                                <label class="col-form-label" for="o_tb_company_zip">Zip Code</label>
                                <input id="o_tb_company_zip" type="text" name="tb_company_zip" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
