<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deltatech_pos_price_lock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='price_control']" position="inside">
                <div class="content-group" invisible="not pos_restrict_price_control">
                    <div class="mt-2">
                        <field name="pos_lock_price_for_managers" />
                        <label
                            for="pos_lock_price_for_managers"
                            string="Managers included"
                            class="fw-normal me-1"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
