<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Jurnalul de activitate urmează vizibilitatea comenzii de vânzare
         (aceleași reguli ca sale.order din modulul sale). -->
    <record id="sale_order_activity_record_comp_rule" model="ir.rule">
        <field name="name">Sale Order Activity Record multi-company</field>
        <field name="model_id" ref="model_sale_order_activity_record" />
        <field name="domain_force">[('sale_order_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="sale_order_activity_record_personal_rule" model="ir.rule">
        <field name="name">Sale Order Activity Record: personal orders</field>
        <field name="model_id" ref="model_sale_order_activity_record" />
        <field
            name="domain_force"
        >['|', ('sale_order_id.user_id', '=', user.id), ('sale_order_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <record id="sale_order_activity_record_see_all" model="ir.rule">
        <field name="name">Sale Order Activity Record: all orders</field>
        <field name="model_id" ref="model_sale_order_activity_record" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]" />
    </record>
</odoo>
