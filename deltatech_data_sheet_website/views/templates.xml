<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="product_data_sheet" inherit_id="website_sale.product" name="Show Data Sheet">
        <!-- The native block is shown only when standard product documents exist;
             show it also when only the data sheet or the safety data sheet is set. -->
        <xpath expr="//div[@id='product_documents']" position="attributes">
            <attribute name="t-if">product_documents or product.data_sheet_id or product.safety_data_sheet_id</attribute>
        </xpath>
        <xpath expr="//div[@id='product_documents']/div[hasclass('list-group')]" position="inside">
            <a
                t-if="product.data_sheet_id"
                class="list-group-item list-group-item-action"
                t-attf-href="/web/content/{{product.data_sheet_id.id}}?download=true"
            >
                <i class="fa fa-download me-2" />
                Show Data Sheet
            </a>
            <a
                t-if="product.safety_data_sheet_id"
                class="list-group-item list-group-item-action"
                t-attf-href="/web/content/{{product.safety_data_sheet_id.id}}?download=true"
            >
                <i class="fa fa-download me-2" />
                Show Safety Data Sheet
            </a>
        </xpath>
    </template>
</odoo>
