<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_attribute_view_form" model="ir.ui.view">
    <field name="name">product.attribute.form.role</field>
    <field name="model">product.attribute</field>
    <field name="inherit_id" ref="product.product_attribute_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='create_variant']" position="after">
        <field name="attribute_role" />
      </xpath>
    </field>
  </record>

  <record id="attribute_tree_view" model="ir.ui.view">
    <field name="name">product.attribute.list.role</field>
    <field name="model">product.attribute</field>
    <field name="inherit_id" ref="product.attribute_tree_view" />
    <field name="arch" type="xml">
      <field name="create_variant" position="after">
        <field name="attribute_role" optional="show" />
      </field>
    </field>
  </record>
</odoo>
