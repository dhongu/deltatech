<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_rfq_tree_picking_status" model="ir.ui.view">
        <field name="name">rfq.tree.picking.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">
            <field name="receipt_status" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>
    <record id="view_purchase_tree_picking_status" model="ir.ui.view">
        <field name="name">purchase.order.tree.picking.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <field name="receipt_status" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>
    <record id="view_purchase_order_filter_picking_status" model="ir.ui.view">
        <field name="name">purchase.order.list.select.picking.status</field>
        <field name="model">purchase.order</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search" />
        <field name="arch" type="xml">
            <filter name="my_Orders" position="after">
                <separator />
                <filter
                    string="Receipt in Progress"
                    name="pickings_in_progress"
                    domain="[('receipt_status', 'in', ('pending', 'partial'))]"
                />
                <filter string="Partially Received" name="receipt_partial" domain="[('receipt_status', '=', 'partial')]" />
                <filter string="Fully Received" name="pickings_done" domain="[('receipt_status', '=', 'full')]" />
            </filter>
            <filter name="vendor" position="after">
                <filter name="receipt_status_groupby" string="Receipt Status" context="{'group_by': 'receipt_status'}" />
            </filter>
        </field>
    </record>
</odoo>
