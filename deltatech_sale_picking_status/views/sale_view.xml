<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_quotation_tree_picking_status" model="ir.ui.view">
        <field name="name">quotation.tree.picking.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="invoice_status" position="before">
                <field
                    name="delivery_status"
                    widget="badge"
                    decoration-success="delivery_status == 'full'"
                    decoration-warning="delivery_status == 'partial'"
                    decoration-info="delivery_status in ['pending', 'started']"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="view_order_tree_picking_status" model="ir.ui.view">
        <field name="name">sale.order.tree.picking.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="delivery_status" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>
    <record id="view_sales_order_filter_picking_status" model="ir.ui.view">
        <field name="name">sale.order.list.select.picking.status</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator />
                <filter
                    string="Delivery in Progress"
                    name="pickings_in_progress"
                    domain="[('delivery_status', 'in', ('pending', 'started', 'partial'))]"
                />
                <filter
                    string="Partially Delivered"
                    name="delivery_partial"
                    domain="[('delivery_status', '=', 'partial')]"
                />
                <filter string="Fully Delivered" name="pickings_done" domain="[('delivery_status', '=', 'full')]" />
            </filter>
            <filter name="customer" position="after">
                <filter name="delivery_status_groupby" string="Delivery Status" context="{'group_by': 'delivery_status'}" />
            </filter>
        </field>
    </record>
</odoo>
