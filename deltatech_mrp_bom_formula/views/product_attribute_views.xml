<odoo>

    <record id="product_attribute_view_form" model="ir.ui.view">
        <field name="name">product.attribute.form.formula</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <field name="display_type" position="before">
                <field name="code" groups="mrp.group_mrp_manager" />
            </field>
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="code" optional="show" groups="mrp.group_mrp_manager" />
                <field name="numeric_value" optional="hide" groups="mrp.group_mrp_manager" />
            </xpath>
        </field>
    </record>

</odoo>
