<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extinde vizualizarea formularului pentru product.template -->
        <record id="view_product_template_form_valuation_class" model="ir.ui.view">
            <field name="name">product.template.form.valuation.class</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='accounting']//group[@name='accounting']" position="inside">
                    <field name="valuation_class_id" options="{'no_create': True}" groups="account.group_account_user"/>
                </xpath>
            </field>
        </record>

        <!-- Adaugă filtru pentru valuation_class_id în vizualizarea de căutare -->
        <record id="view_product_template_search_valuation_class" model="ir.ui.view">
            <field name="name">product.template.search.valuation.class</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <field name="categ_id" position="after">
                    <field name="valuation_class_id"/>
                </field>
                <filter name="categ_id" position="after">
                    <filter string="Valuation Class" name="valuation_class_id" context="{'group_by':'valuation_class_id'}"/>
                </filter>
            </field>
        </record>

        <!-- Adaugă coloana în vizualizarea de tip listă -->
        <record id="view_product_template_tree_valuation_class" model="ir.ui.view">
            <field name="name">product.template.tree.valuation.class</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <field name="uom_id" position="after">
                    <field name="valuation_class_id" optional="hide" groups="account.group_account_user"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
