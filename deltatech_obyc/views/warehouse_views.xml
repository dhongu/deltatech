<odoo>

      <!-- Extend Warehouse Form View to add valuation_area_id field -->
    <record id="view_warehouse_form_valuation_area" model="ir.ui.view">
        <field name="name">stock.warehouse.form.valuation.area</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="valuation_area_id" options="{'no_create': True}" groups="stock.group_stock_manager" />
            </xpath>
        </field>
    </record>

    <!-- Extend Warehouse Tree View to add valuation_area_id field -->
    <record id="view_warehouse_tree_valuation_area" model="ir.ui.view">
        <field name="name">stock.warehouse.tree.valuation.area</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="valuation_area_id" optional="show" groups="stock.group_stock_manager" />
            </field>
        </field>
    </record>




</odoo>
