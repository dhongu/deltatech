<odoo>
    <record id="view_product_valuation_area_tree" model="ir.ui.view">
        <field name="name">product.valuation.area.tree</field>
        <field name="model">product.valuation.area</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_product_valuation_area_form" model="ir.ui.view">
        <field name="name">product.valuation.area.form</field>
        <field name="model">product.valuation.area</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="company_id"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_product_valuation_area" model="ir.actions.act_window">
        <field name="name">Product Valuation Area</field>
        <field name="res_model">product.valuation.area</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
