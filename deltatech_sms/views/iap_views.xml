<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="iap_account_view_form" model="ir.ui.view">
        <field name="name">iap.account.form</field>
        <field name="model">iap.account</field>
        <field name="inherit_id" ref="iap.iap_account_view_form" />
        <field name="arch" type="xml">
            <!-- 20.0: `name` moved to the form title (h1); keep the SMS settings in the
                 "Account Information" group, right where they were in 19.0 (after `name`) -->
            <xpath expr="//group[@name='account']/field[@name='service_id']" position="before">
                <field name="sms_provider" />
                <field name="sms_secret" />
                <field name="sms_gateway" />
            </xpath>
        </field>
    </record>
</odoo>
