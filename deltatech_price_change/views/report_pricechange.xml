<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <template id="report_pricechange">
            <t t-name="deltatech_price_change.report_pricechange">
                    <t t-call="web.html_container">
                        <t t-foreach="docs" t-as="o">
                            <t t-call="web.external_layout">
                                <div class="page">
                                    <newline />
                                    <h2>
                                        Price change:
                                        <span t-field="o.name" />
                                    </h2>
                                    <h3>
                                        from date:
                                        <span t-field="o.date" />
                                    </h3>
                                    <div>
                                        <div t-if="o.location_id">
                                            Location:
                                            <span t-field="o.location_id" />
                                        </div>
                                    </div>
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <strong>Description</strong>
                                                </th>
                                                <th t-if="o.type == 'product'">
                                                    <strong>Quantity</strong>
                                                </th>
                                                <th>
                                                    <strong>Old Price</strong>
                                                </th>
                                                <th t-if="o.type == 'product'">
                                                    <strong>Old Amount</strong>
                                                </th>
                                                <th>
                                                    <strong>New Price</strong>
                                                </th>
                                                <th t-if="o.type == 'product'">
                                                    <strong>New Amount</strong>
                                                </th>
                                                <th t-if="o.type == 'product'">
                                                    <strong>Difference Amount</strong>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="o.default_pricelist_id">
                                                <t
                                            t-set="line_ids"
                                            t-value="o.line_ids.filtered(lambda l: l.pricelist_id == o.default_pricelist_id)"
                                        />
                                            </t>
                                            <t t-else="">
                                                <t t-set="line_ids" t-value="o.line_ids" />
                                            </t>
                                            <tr t-foreach="line_ids" t-as="line">
                                                <td>
                                                    <span
                                                t-field="line.product_id.name or line.product_template_id.name"
                                            />
                                                </td>
                                                <td t-if="o.type == 'product'">
                                                    <span t-field="line.quantity" />
                                                </td>
                                                <td>
                                                    <span t-field="line.old_price" />
                                                </td>
                                                <td t-if="o.type == 'product'">
                                                    <span t-field="line.old_amount" />
                                                </td>
                                                <td>
                                                    <span t-field="line.new_price" />
                                                </td>
                                                <td t-if="o.type == 'product'">
                                                    <span t-field="line.new_amount" />
                                                </td>
                                                <td t-if="o.type == 'product'">
                                                    <span t-field="line.diff_amount" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </div>
                            </t>
                        </t>
                    </t>
                </t>
        </template>

    <template id="report_pricechange_product">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="o">
                <div id="product_name">
                    <strong>
                        <span t-esc="o.name" />
                    </strong>
                </div>
                <t t-set="price_change_items" t-value="o.get_price_change_items()" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <td>Date</td>
                            <td>Old price</td>
                            <td>New price</td>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <span t-field="o.create_date" />
                            </td>
                            <td>
                                <span>-</span>
                            </td>
                            <td>
                                <span t-field="o.list_price" />
                            </td>
                        </tr>
                        <t t-if="price_change_items">
                            <tr t-foreach="price_change_items" t-as="change_item">
                                <td>
                                    <span t-field="change_item.price_change_id.date" />
                                </td>
                                <td>
                                    <span t-field="change_item.old_price" />
                                </td>
                                <td>
                                    <span t-field="change_item.new_price" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
                </div>
            </t>
        </t>
    </template>

    <template id="report_pricechange_variant">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="o">
                <div id="product_name">
                    <strong>
                        <span t-esc="o.display_name" />
                    </strong>
                </div>
                <t t-set="price_change_items" t-value="o.get_price_change_items()" />
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <td>Date</td>
                            <td>Old price</td>
                            <td>New price</td>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <span t-field="o.create_date" />
                            </td>
                            <td>
                                <span>-</span>
                            </td>
                            <td>
                                <span t-field="o.list_price" />
                            </td>
                        </tr>
                        <t t-if="price_change_items">
                            <tr t-foreach="price_change_items" t-as="change_item">
                                <td>
                                    <span t-field="change_item.price_change_id.date" />
                                </td>
                                <td>
                                    <span t-field="change_item.old_price" />
                                </td>
                                <td>
                                    <span t-field="change_item.new_price" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
