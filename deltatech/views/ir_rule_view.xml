<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="base_view_rule_form_inherit" model="ir.ui.view">
        <field name="name">ir.rule.form.inherit</field>
        <field name="model">ir.rule</field>
        <field name="inherit_id" ref="base.view_rule_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="model_name" />
            </xpath>
            <xpath expr="//field[@name='domain_force']" position="attributes">
                <attribute name="widget">domain</attribute>
                <attribute name="options">{'model': 'model_name', 'in_dialog': true}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
