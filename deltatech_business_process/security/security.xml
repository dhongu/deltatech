    </record>
    <record model="ir.rule" id="business_issue_visibility_manager_rule">
        <field name="name">Business issue visibility: admin bypass</field>
        <field name="model_id" ref="model_business_issue" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_business_process_manager'))]" />
    </record>
    <record model="ir.rule" id="business_open_issue_visibility_manager_rule">
        <field name="name">Business open issue visibility: admin bypass</field>
        <field name="model_id" ref="model_business_open_issue" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_business_process_manager'))]" />
    </record>
    <record model="ir.rule" id="business_process_report_visibility_manager_rule">
        <field name="name">Business process report visibility: admin bypass</field>
        <field name="model_id" ref="model_business_process_report" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_business_process_manager'))]" />
    </record>
    <record model="ir.rule" id="business_process_test_report_visibility_manager_rule">
        <field name="name">Business process test report visibility: admin bypass</field>
        <field name="model_id" ref="model_business_process_test_report" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_business_process_manager'))]" />
    </record>

</odoo>
