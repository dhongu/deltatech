<odoo>
    <record id="view_pricelist_excel_wizard_form" model="ir.ui.view">
        <field name="name">pricelist.excel.wizard.form</field>
        <field name="model">pricelist.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Excel With Pricelist">
                <group>
                    <field name="price_list_id" />
                    <field name="partner_id" />
                    <field name="price_without_discounts" />
                </group>
                <footer>
                    <button string="Create Excel" type="object" name="do_compute" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_pricelist_excel_wizard" model="ir.actions.act_window">
        <field name="name">Pricelist Excel Wizard</field>
        <field name="res_model">pricelist.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_pricelist_excel_wizard"
        name="Pricelist Excel Wizard"
        parent="sale.menu_sale_report"
        action="action_pricelist_excel_wizard"
        sequence="10"
    />
</odoo>
