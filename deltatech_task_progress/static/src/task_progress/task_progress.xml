<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="deltatech_task_progress.TaskProgressDialog">
        <Dialog title="props.title" size="'md'" footer="false">
            <t t-set-slot="header" t-slot-scope="scope">
                <h4 class="modal-title text-break flex-grow-1" t-esc="props.title" />
                <button
                    t-if="!busy"
                    type="button"
                    class="btn-close"
                    aria-label="Close"
                    tabindex="-1"
                    t-on-click="() => this.closeDialog()"
                />
            </t>
            <div class="p-3">
                <p t-if="props.intro and !state.started" class="o_task_progress_intro" t-esc="props.intro" />

                <div t-if="state.started or state.preparing" class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold o_task_progress_state" t-esc="statusLabel" />
                        <span class="text-muted small">
                            <t t-esc="progressPercent" />%
                            <t t-if="etaLabel and state.running"> — <t t-esc="etaLabel" /></t>
                        </span>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div
                            class="progress-bar"
                            t-att-class="busy ? 'progress-bar-striped progress-bar-animated' : (failedRows.length or state.stopping or warningsCount ? 'bg-warning' : 'bg-success')"
                            role="progressbar"
                            t-att-style="'width: ' + progressPercent + '%'"
                            t-att-aria-valuenow="progressPercent"
                            aria-valuemin="0"
                            aria-valuemax="100"
                        />
                    </div>
                    <div class="mt-1 text-muted small o_task_progress_counter">
                        <t t-esc="counterLabel" />
                    </div>
                </div>

                <div t-if="state.fatal" class="alert alert-danger o_task_progress_fatal">
                    <i class="fa fa-times-circle me-2" />
                    <t t-esc="state.fatal" />
                </div>

                <table t-if="props.showItems and state.rows.length" class="table table-sm o_task_progress_items">
                    <tbody>
                        <t t-foreach="state.rows" t-as="row" t-key="row_index">
                            <tr t-att-class="'o_task_progress_item_' + row.status">
                                <td t-esc="row.name" />
                                <td>
                                    <span t-if="row.status === 'pending'" class="text-muted">—</span>
                                    <span t-if="row.status === 'running'" class="fa fa-spinner fa-spin" />
                                    <span t-if="row.status === 'success'" class="text-success">
                                        <i class="fa fa-check" /> <t t-esc="row.message" />
                                    </span>
                                    <span t-if="row.status === 'warning'" class="text-warning">
                                        <i class="fa fa-exclamation-triangle" /> <t t-esc="row.message" />
                                    </span>
                                    <span t-if="row.status === 'error'" class="text-danger">
                                        <i class="fa fa-times" /> <t t-esc="row.message" />
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <t t-elif="failedRows.length and !busy">
                    <div class="alert alert-warning mb-2">
                        <i class="fa fa-exclamation-triangle me-2" />
                        <t t-esc="errorsLabel" />
                    </div>
                    <div class="border rounded p-2 bg-light mb-3" style="max-height: 180px; overflow-y: auto;">
                        <t t-foreach="errors" t-as="err" t-key="err_index">
                            <div class="text-danger small o_task_progress_error" t-esc="err" />
                        </t>
                    </div>
                </t>

                <div class="text-end d-flex justify-content-end gap-2">
                    <button
                        t-if="state.running"
                        class="btn btn-secondary o_task_progress_stop"
                        t-att-disabled="state.stopping"
                        t-on-click="stop"
                        t-esc="labels.stop"
                    />
                    <t t-else="">
                        <button
                            t-if="canStart"
                            class="btn btn-primary o_task_progress_start"
                            t-on-click="() => this.run()"
                            t-esc="labels.start"
                        />
                        <button
                            t-if="canRetry"
                            class="btn btn-primary o_task_progress_retry"
                            t-on-click="retry"
                            t-esc="labels.retry"
                        />
                        <button
                            t-if="canFinish"
                            t-att-class="'btn o_task_progress_finish ' + (canRetry ? 'btn-secondary' : 'btn-primary')"
                            t-att-disabled="state.finishing"
                            t-on-click="() => this.finish()"
                            t-esc="labels.finish"
                        />
                        <button
                            class="btn btn-secondary o_task_progress_close"
                            t-att-disabled="busy"
                            t-on-click="() => this.closeDialog()"
                        >Close</button>
                    </t>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
