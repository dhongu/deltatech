<odoo>
    <record id="view_sale_return_cause_tree" model="ir.ui.view">
        <field name="name">sale.return.cause.list</field>
        <field name="model">sale.return.cause</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_sale_return_cause_form" model="ir.ui.view">
        <field name="name">sale.return.cause.form</field>
        <field name="model">sale.return.cause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_return_cause" model="ir.actions.act_window">
        <field name="name">Return Causes</field>
        <field name="res_model">sale.return.cause</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sale_return_cause"
        action="action_sale_return_cause"
        parent="sale.menu_sale_config"
        sequence="100"
    />
</odoo>
