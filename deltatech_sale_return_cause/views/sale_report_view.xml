<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_product_search" model="ir.ui.view">
        <field name="name">sale.report.search.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='status']" position="after">
                <filter string="Return Cause (Legacy)" name="return_cause" context="{'group_by':'return_cause'}" />
                <filter string="Return Cause" name="return_cause_id" context="{'group_by':'return_cause_id'}" />
                <filter
                    string="Return Cause Date"
                    name="return_cause_date"
                    context="{'group_by':'return_cause_date'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
