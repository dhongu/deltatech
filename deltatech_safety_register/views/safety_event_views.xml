<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_safety_event_search" model="ir.ui.view">
        <field name="name">deltatech.safety.event.search</field>
        <field name="model">deltatech.safety.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="employee_id" />
                <field name="partner_id" />
                <field name="injured_name" />
                <field name="location" />
                <filter name="reported" string="Reported" domain="[('state', '=', 'reported')]" />
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]" />
                <separator />
                <filter name="near_miss" string="Near misses" domain="[('event_type', '=', 'near_miss')]" />
                <filter name="injuries" string="Injuries" domain="[('is_injury', '=', True)]" />
                <filter name="commute" string="Commuting accidents" domain="[('is_commute', '=', True)]" />
                <separator />
                <filter name="filter_date" string="Date" date="date" />
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'event_type'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}" />
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_safety_event_list" model="ir.ui.view">
        <field name="name">deltatech.safety.event.list</field>
        <field name="model">deltatech.safety.event</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-danger="event_type in ('lost_time_injury', 'fatal')">
                <field name="name" />
                <field name="date" />
                <field name="event_type" widget="badge" />
                <field name="location" optional="show" />
                <field name="employee_id" optional="show" />
                <field name="partner_id" optional="hide" />
                <field name="injured_name" optional="hide" />
                <field name="department_id" optional="hide" />
                <field name="is_commute" optional="show" width="140px" />
                <field name="open_action_count" width="140px" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state == 'reported'" />
            </list>
        </field>
    </record>

    <record id="view_safety_event_form" model="ir.ui.view">
        <field name="name">deltatech.safety.event.form</field>
        <field name="model">deltatech.safety.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_close"
                        type="object"
                        string="Close"
                        class="btn-primary"
                        invisible="state != 'reported'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_type" />
                            <field name="date" />
                            <field name="location" />
                            <field name="is_injury" invisible="1" />
                            <field name="is_commute" invisible="not is_injury" />
                        </group>
                        <group>
                            <field name="employee_id" invisible="not is_injury" />
                            <field name="partner_id" invisible="not is_injury" />
                            <field name="injured_name" invisible="not is_injury" />
                            <field name="department_id" invisible="not employee_id" />
                            <field name="closed_date" invisible="state != 'closed'" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What happened, where, who was involved..." />
                        </page>
                        <page string="Root cause" name="root_cause">
                            <field name="root_cause" placeholder="Why did it happen?" />
                        </page>
                        <page string="Corrective actions" name="actions">
                            <field name="action_ids">
                                <list editable="bottom" decoration-muted="state == 'done'">
                                    <field name="description" />
                                    <field name="user_id" />
                                    <field name="deadline" />
                                    <field name="state" widget="badge" decoration-success="state == 'done'" />
                                    <field name="done_date" optional="show" />
                                    <button
                                        name="action_done"
                                        type="object"
                                        string="Mark done"
                                        icon="fa-check"
                                        invisible="state != 'open' or not id"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_safety_event" model="ir.actions.act_window">
        <field name="name">Safety events</field>
        <field name="res_model">deltatech.safety.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_safety_event_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record the first safety event</p>
            <p>Near misses, incidents and work accidents, with root cause and corrective actions.</p>
        </field>
    </record>
</odoo>
