<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="deltatech_web_side_panel.SidePanel">
        <aside
            class="o_side_panel d-flex flex-column"
            t-att-class="{'o_side_panel_resizing': this.state.resizing}"
            t-att-style="this.rootStyle"
            t-ref="this.rootRef"
            role="complementary"
        >
            <div
                class="o_side_panel_resizer"
                role="separator"
                aria-orientation="vertical"
                tabindex="0"
                title="Resize the panel (double click to reset)"
                aria-label="Resize the panel"
                t-att-aria-valuenow="this.state.current"
                t-att-aria-valuemin="this.minWidth"
                t-att-aria-valuemax="this.state.max"
                t-on-pointerdown="this.onResizeStart"
                t-on-pointermove="this.onResizeMove"
                t-on-pointerup="this.onResizeEnd"
                t-on-pointercancel="this.onResizeEnd"
                t-on-dblclick="this.onResizeReset"
                t-on-keydown="this.onResizeKeydown"
            />
            <div
                class="o_side_panel_header d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-bottom"
            >
                <span class="o_side_panel_position text-muted small" t-out="this.positionLabel" />
                <div class="btn-group">
                    <button
                        type="button"
                        class="btn btn-secondary o_side_panel_prev"
                        title="Previous record"
                        aria-label="Previous record"
                        t-on-click="this.props.onPrev"
                    >
                        <i class="oi oi-fw" data-icon="arrow_back_ios_new" />
                    </button>
                    <button
                        type="button"
                        class="btn btn-secondary o_side_panel_next"
                        title="Next record"
                        aria-label="Next record"
                        t-on-click="this.props.onNext"
                    >
                        <i class="oi oi-fw" data-icon="arrow_forward_ios" />
                    </button>
                    <button
                        type="button"
                        class="btn btn-secondary o_side_panel_open"
                        title="Open the full form"
                        aria-label="Open the full form"
                        t-on-click="this.props.onOpen"
                    >
                        <i class="oi oi-fw" data-icon="open_in_new" />
                    </button>
                    <button
                        type="button"
                        class="btn btn-secondary o_side_panel_refresh"
                        title="Refresh"
                        aria-label="Refresh"
                        t-on-click="this.props.onRefresh"
                    >
                        <i class="oi oi-fw" data-icon="refresh" />
                    </button>
                    <button
                        type="button"
                        class="btn btn-secondary o_side_panel_close"
                        title="Close the panel"
                        aria-label="Close the panel"
                        t-on-click="this.props.onClose"
                    >
                        <i class="oi oi-fw" data-icon="close" />
                    </button>
                </div>
            </div>
            <div class="o_side_panel_body flex-grow-1 overflow-auto">
                <View t-props="this.viewProps" />
            </div>
        </aside>
    </t>

    <t t-name="deltatech_web_side_panel.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="after">
            <SidePanel t-if="this.sidePanelVisible" t-key="this.sidePanelKey" t-props="this.sidePanelProps" />
        </xpath>
    </t>

    <t t-name="deltatech_web_side_panel.KanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="after">
            <SidePanel t-if="this.sidePanelVisible" t-key="this.sidePanelKey" t-props="this.sidePanelProps" />
        </xpath>
    </t>

</templates>
