<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <template
        id="website_sale_stock_product"
        inherit_id="website_sale.cta_wrapper"
        priority="4"
        active="True"
        customize_show="True"
        name="Product Available"
    >
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
          <div class="lead_time_messages o_not_editable" />
        </xpath>
      </template>


     <template
        id="website_sale_stock_product_lead_time"
        inherit_id="website_sale.cta_wrapper"
        priority="5"
        active="True"
        customize_show="True"
        name="Delivery Lead Time"
    >
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
          <div class="lead_time_messages_interval o_not_editable" />
        </xpath>
      </template>


<!--    <template id="website_sale_stock_product_lead_time" inherit_id="website_sale.product" priority="99">
        <xpath expr="//form" position="before">
            <div class="lead_time_messages o_not_editable">
                <div style="font-size: medium;" class="badge rounded-pill">
                    In stock
                </div>
            </div>
        </xpath>
    </template>-->

    <!-- Stock status on the shop product card: style, position and out of stock
         color are set from the website builder ("Products Design" panel) through
         o_wsale_products_opt_stock_* classes, saved in shop_opt_products_design_classes. -->
    <template id="product_tile_stock_status" name="Product tile stock status">
        <t t-set="stock_design" t-value="design_field or ''" />
        <t
            t-set="stock_enabled"
            t-value="'o_wsale_products_opt_stock_text' in stock_design or 'o_wsale_products_opt_stock_led' in stock_design"
        />
        <t
            t-set="stock_position"
            t-value="'image' if 'o_wsale_products_opt_stock_pos_image' in stock_design else 'price' if 'o_wsale_products_opt_stock_pos_price' in stock_design else 'info'"
        />
        <t
            t-if="request.env.user.has_group('website.group_website_designer') or (stock_enabled and stock_position == position)"
        >
            <t t-set="stock_in" t-value="product.sudo().qty_available &gt; 0" />
            <t t-if="stock_in" t-set="stock_label">Immediate delivery</t>
            <t t-else="" t-set="stock_label">Subsequent delivery</t>
            <div
                t-attf-class="o_wsale_stock_status o_wsale_stock_status_#{position} #{'o_wsale_stock_in' if stock_in else 'o_wsale_stock_out'} o_not_editable"
                t-att-title="stock_label"
                contenteditable="false"
            >
                <span class="o_wsale_stock_led" role="img" t-att-aria-label="stock_label" />
                <span class="o_wsale_stock_label" t-out="stock_label" />
            </div>
        </t>
    </template>

    <template
        id="products_item_stock_status"
        inherit_id="website_sale.products_item"
        name="Product card stock status"
        priority="500"
    >
        <xpath expr="//div[contains(@t-attf-class, 'oe_product_image ')]" position="inside">
            <t t-call="deltatech_website_stock_availability.product_tile_stock_status">
                <t t-set="position" t-value="'image'" />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="before">
            <t t-call="deltatech_website_stock_availability.product_tile_stock_status">
                <t t-set="position" t-value="'info'" />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="before">
            <t t-call="deltatech_website_stock_availability.product_tile_stock_status">
                <t t-set="position" t-value="'price'" />
            </t>
        </xpath>
    </template>



    <template
        id="cart_summary_website_sale_stock_product_lead_time"
        inherit_id="website_sale.checkout_layout"
        name="Delivery Lead Time"
        active="False"
        customize_show="True"
    >
        <xpath expr="//td[hasclass('td-product_name')]/div/strong" position="after">
            <xpath expr="//div" position="after">
                <t t-if="line.product_id.qty_available  &gt;=   line.product_uom_qty">
                    <div class="o_immediate_delivery">
                        <span class="badge bg-success">Immediate delivery</span>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_subsequent_delivery">
                        <span class="badge bg-warning">Subsequent delivery</span>
                    </div>
                </t>
            </xpath>
        </xpath>
    </template>


    <template
        id="cart_line_description_following_lines"
        inherit_id="website_sale.cart_line_description_following_lines"
        customize_show="True"
        name="Delivery Lead Time"
    >
        <xpath expr="//div" position="after">
            <t t-set="line_free_qty" t-value="line._get_website_free_qty()" />
            <t t-if="line_free_qty &gt;= line.product_uom_qty">
                <span class="badge bg-success">Immediate delivery</span>
            </t>
            <t t-else="">
                <t t-if="line_free_qty &gt; 0">
                    <span class="badge bg-success" t-out="round(line_free_qty, 3)" />
                    <span class="badge bg-success">Immediate delivery</span>
                </t>
                <span class="badge bg-warning">Subsequent delivery</span>
            </t>
        </xpath>
    </template>

</odoo>
