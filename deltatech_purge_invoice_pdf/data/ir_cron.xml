<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_dt_purge_invoice_pdf" model="ir.cron">
        <field name="name">Purge Invoice PDF: delete auto-generated PDF attachments</field>
        <field name="model_id" ref="base.model_ir_attachment" />
        <field name="state">code</field>
        <field name="code">model._dt_purge_invoice_pdf_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <!-- Disabled by default: this is a staging/test-instance maintenance
             tool (e.g. PTC), not something to run unattended on production.
             noupdate="1" so that enabling it manually survives a module
             upgrade instead of being silently switched back off. -->
        <field name="active" eval="False" />
        <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 02:00:00')" />
    </record>

</odoo>
