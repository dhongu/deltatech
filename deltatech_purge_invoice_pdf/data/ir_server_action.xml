<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Runnable manually from Settings > Technical > Server Actions, without
         waiting for the cron or enabling it. Visible in Settings > Technical
         because it needs no binding to a specific record/view. -->
    <record id="ir_server_action_purge_invoice_pdf" model="ir.actions.server">
        <field name="name">Purge invoice PDF attachments</field>
        <field name="model_id" ref="base.model_ir_attachment" />
        <field name="state">code</field>
        <field name="code">model._dt_purge_invoice_pdf_run()</field>
    </record>

</odoo>
