<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='production_lot_info']" position="inside">
                <setting company_dependent="1" help="No negative stocks are allowed">
                    <field name="no_negative_stock" />
                </setting>
                <setting
                    company_dependent="1"
                    help="The goods leave the shop as the receipt is paid, so a Point of Sale delivery is validated even when it takes the location below zero. The bypass is logged and the deviation stays visible as negative stock."
                    invisible="not no_negative_stock"
                >
                    <field name="no_negative_stock_pos_bypass" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
