<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.category.icon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="product_attributes_setting" position="after">
                <setting
                    id="category_icon_levels_setting"
                    string="Category Icons in List"
                    help="Which categories of the shop's category list show an icon"
                >
                    <field name="category_icon_levels" widget="radio" />
                </setting>
            </setting>
        </field>
    </record>

</odoo>
