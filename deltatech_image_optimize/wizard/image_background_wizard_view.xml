<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_image_background_wizard_form" model="ir.ui.view">
        <field name="name">deltatech.image.background.wizard.form</field>
        <field name="model">deltatech.image.background.wizard</field>
        <field name="arch" type="xml">
            <form string="Remove Image Background">
                <field name="mode" invisible="1" />
                <div invisible="mode != 'preview'">
                    <p>
                        Check the result before applying it. The original image is
                        <strong>not kept</strong>: once applied, the background cannot be
                        put back. Untick the images where the product was not cut out well.
                    </p>
                    <group>
                        <group>
                            <field name="method" />
                            <field name="bg_model" invisible="method == 'uniform'" />
                        </group>
                        <group>
                            <button
                                name="action_refresh"
                                string="Refresh Preview"
                                type="object"
                                class="btn-secondary"
                                icon="fa-refresh"
                            />
                        </group>
                    </group>
                    <div invisible="failed_count == 0" class="alert alert-warning" role="alert">
                        <field name="failed_count" class="d-inline" /> image(s) could not be cut out
                        (the reason is in the Warning column); they stay unchanged.
                    </div>
                    <div invisible="warning_count == 0" class="alert alert-warning" role="alert">
                        <field name="warning_count" class="d-inline" /> image(s) need a check: they
                        are unticked. Tick them only if the result is right.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="to_apply" readonly="not image_after" />
                            <field name="name" readonly="1" />
                            <field
                                name="image_before"
                                widget="image"
                                options="{'size': [220, 220]}"
                                readonly="1"
                                width="230px"
                            />
                            <field
                                name="image_after"
                                widget="image"
                                options="{'size': [220, 220]}"
                                readonly="1"
                                width="230px"
                                class="o_dt_bg_checker"
                            />
                            <field name="warning" decoration-warning="warning" width="260px" />
                        </list>
                    </field>
                </div>
                <div invisible="mode != 'queue'">
                    <div class="alert alert-warning" role="alert">
                        <field name="image_count" class="d-inline" /> images selected — too many to preview.
                        Their background is removed by a scheduled action, in batches, with the method
                        set in the system parameters, and the original images are
                        <strong>not kept</strong>. Try a few images first to check the result.
                    </div>
                </div>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="oe_highlight"
                        invisible="mode != 'preview'"
                    />
                    <button
                        name="action_apply"
                        string="Queue"
                        type="object"
                        class="oe_highlight"
                        invisible="mode != 'queue'"
                        confirm="The original images will not be kept. Continue?"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
