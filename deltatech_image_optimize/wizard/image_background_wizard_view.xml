<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_image_background_wizard_form" model="ir.ui.view">
        <field name="name">deltatech.image.background.wizard.form</field>
        <field name="model">deltatech.image.background.wizard</field>
        <field name="arch" type="xml">
            <form string="Remove Image Background">
                <field name="mode" invisible="1" />
                <div invisible="mode != 'preview'">
                    <p>
                        Check the result before applying it. The original image is
                        <strong>not kept</strong>: once applied, the background cannot be
                        put back. Untick the images where the product was not cut out well.
                    </p>
                    <div invisible="failed_count == 0" class="alert alert-warning" role="alert">
                        No product was found in <field name="failed_count" class="d-inline" /> image(s);
                        they stay unchanged.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="to_apply" readonly="not image_after" />
                            <field name="name" readonly="1" />
                            <field name="image_before" widget="image" options="{'size': [160, 160]}" readonly="1" />
                            <field name="image_after" widget="image" options="{'size': [160, 160]}" readonly="1" />
                        </list>
                    </field>
                </div>
                <div invisible="mode != 'queue'">
                    <div class="alert alert-warning" role="alert">
                        <field name="image_count" class="d-inline" /> images selected — too many to preview.
                        Their background is removed by a scheduled action, in batches, and the
                        original images are <strong>not kept</strong>. Try a few images first to
                        check the result.
                    </div>
                </div>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="oe_highlight"
                        invisible="mode != 'preview'"
                    />
                    <button
                        name="action_apply"
                        string="Queue"
                        type="object"
                        class="oe_highlight"
                        invisible="mode != 'queue'"
                        confirm="The original images will not be kept. Continue?"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
