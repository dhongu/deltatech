<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="deltatech_image_optimize.ImageBackgroundOption">
        <BuilderRow label.translate="Background">
            <BuilderButton
                action="'dtRemoveImageBackground'"
                title.translate="Cut out the product: the background of the picture becomes transparent"
                className="'flex-grow-1'"
                preview="false"
                label.translate="Remove Background"
            />
        </BuilderRow>
    </t>

    <!-- imaginile de produs din pagină: câmpul imaginii pe produs, variantă sau galerie,
         imediat după opțiunile Media / Re-order ale imaginilor de produs -->
    <t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//t[@id='image_options']" position="before">
            <dt_image_background_option
                template="deltatech_image_optimize.ImageBackgroundOption"
                selector="[data-oe-type='image'][data-oe-model='product.template'][data-oe-field='image_1920'] > img, [data-oe-type='image'][data-oe-model='product.product'][data-oe-field='image_1920'] > img, [data-oe-type='image'][data-oe-model='product.image'][data-oe-field='image_1920'] > img"
            />
        </xpath>
    </t>

</templates>
