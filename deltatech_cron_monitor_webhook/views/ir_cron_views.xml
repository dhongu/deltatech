<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_view_form_inherit_monitoring" model="ir.ui.view">
        <field name="name">ir.cron.view.form.inherit.monitoring</field>
        <field name="model">ir.cron</field>
        <field name="inherit_id" ref="base.ir_cron_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//notebook" position="inside">

                    <page string="Webhook Configuration" name="webhook_config">
                        <group>
                            <group>
                                <field name="enable_webhook" />
                                <field name="webhook_code" invisible="not enable_webhook" />
                                <field name="webhook_url" widget="url" invisible="not enable_webhook" />
                            </group>
                        </group>
                    </page>

            </xpath>
        </field>
    </record>
</odoo>
