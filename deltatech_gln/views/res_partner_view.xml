<?xml version="1.0" ?>
<odoo>
    <!-- the standard GLN is shown only on delivery addresses; show it on every partner -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.gln</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_add_gln.view_partner_form_inherit" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='sales_purchases']//field[@name='global_location_number']"
                position="attributes"
            >
                <attribute name="invisible" />
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='global_location_number']" position="attributes">
                <attribute name="invisible" />
            </xpath>
        </field>
    </record>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="name">res.partner.simplified.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="inside">
                <field name="global_location_number" />
            </xpath>
        </field>
    </record>
</odoo>
