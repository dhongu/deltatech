<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- În Odoo 19 filtrele de atribute (desktop + offcanvas mobil) trec toate prin
         website_sale.product_attribute_filters_form, care deleagă per tip de afișare
         către sub-template-urile filter_*. Filtrăm valorile în fiecare sub-template. -->

    <template id="filter_select_attributes" inherit_id="website_sale.filter_select_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute
                name="t-foreach"
            >a.value_ids.filtered(lambda v: not active_attribute_value_ids or v.id in active_attribute_value_ids)</attribute>
        </xpath>
    </template>

    <template id="filter_color_attributes" inherit_id="website_sale.filter_color_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute
                name="t-foreach"
            >a.value_ids.filtered(lambda v: not active_attribute_value_ids or v.id in active_attribute_value_ids)</attribute>
        </xpath>
    </template>

    <template id="filter_image_attributes" inherit_id="website_sale.filter_image_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute
                name="t-foreach"
            >a.value_ids.filtered(lambda v: not active_attribute_value_ids or v.id in active_attribute_value_ids)</attribute>
        </xpath>
    </template>

    <template id="filter_pills_attributes" inherit_id="website_sale.filter_pills_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute
                name="t-foreach"
            >a.value_ids.filtered(lambda v: not active_attribute_value_ids or v.id in active_attribute_value_ids)</attribute>
        </xpath>
    </template>

    <!-- Radio și multi folosesc sorted_values pentru toate buclele interne și pentru
         pragurile de afișare (<=20, View More), deci filtrăm o singură dată la t-set. -->
    <template
        id="filter_radio_and_multi_attributes"
        inherit_id="website_sale.filter_radio_and_multi_attributes"
    >
        <xpath expr="//t[@t-set='sorted_values']" position="attributes">
            <attribute
                name="t-value"
            >sorted(a.value_ids.filtered(lambda v: not active_attribute_value_ids or v.id in active_attribute_value_ids), key=lambda v: v.id not in attrib_set)</attribute>
        </xpath>
    </template>
</odoo>
