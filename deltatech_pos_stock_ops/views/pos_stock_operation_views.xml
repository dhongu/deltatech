<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pos_stock_operation_view_list" model="ir.ui.view">
        <field name="name">pos.stock.operation.list</field>
        <field name="model">pos.stock.operation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" />
                <field name="name" />
                <field name="operation_type" />
                <field name="partner_id" />
                <field name="config_id" />
                <field name="user_id" />
                <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'done'" />
            </list>
        </field>
    </record>
    <record id="pos_stock_operation_action" model="ir.actions.act_window">
        <field name="name">POS Stock Operations</field>
        <field name="res_model">pos.stock.operation</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="pos_stock_operation_menu"
        name="Stock Operations"
        parent="point_of_sale.menu_point_of_sale"
        action="pos_stock_operation_action"
        groups="deltatech_pos_stock_ops.group_pos_stock_ops"
        sequence="30"
    />
</odoo>
