<?xml version="1.0" ?>
<odoo>
    <record id="view_warehouse_inherit_stock" model="ir.ui.view">
        <field name="name">Stock Warehouse Inherit Stock</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kanban_display_stock" />
            </xpath>
        </field>
    </record>


</odoo>
