<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_deltatech_stock_inventory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.deltatech.stock.inventory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='production_lot_info']" position="inside">
                <setting
                    id="group_show_manual_location_fields_setting"
                    string="Show manual location fields"
                    help="Show Rack/Row/Shelf/Case fields on products and inventory. Enable this when you do not use putaway (storage) rules."
                >
                    <field name="group_show_manual_location_fields" />

                </setting>
                <setting
                    id="kanban_stock_warehouse_sequence_setting"
                    string="Kanban stock by warehouse sequence"
                    help="List the stock per warehouse on the product Kanban in the order of the warehouses (drag to reorder them in the Warehouses list), not alphabetically."
                >
                    <field name="kanban_stock_warehouse_sequence" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
