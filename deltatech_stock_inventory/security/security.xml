<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <record id="group_change_inventory_date" model="res.groups">
            <field name="name">Allow to change inventory date</field>
            <field name="category_id" ref="base.module_category_hidden" />
        </record>
        <record id="group_view_inventory_button" model="res.groups">
            <field name="name">Can update quantities</field>
            <field name="category_id" ref="base.module_category_hidden" />
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
        <record id="group_merge_inventory" model="res.groups">
            <field name="name">Can merge inventory documents</field>
            <field name="category_id" ref="base.module_category_hidden" />
        </record>

        <!-- Category for Deltatech Inventory settings -->
        <record id="module_category_deltatech_inventory" model="ir.module.category">
            <field name="name">Deltatech Inventory</field>
            <field name="description">Settings for showing manual location fields</field>
            <field name="sequence" eval="30" />
        </record>

        <!-- Group used to toggle visibility of manual location fields in views -->
        <record id="group_show_manual_location_fields" model="res.groups">
            <field name="name">Show manual location fields (Rack/Row/Shelf/Case)</field>
            <field name="category_id" ref="deltatech_stock_inventory.module_category_deltatech_inventory" />
        </record>

</odoo>
