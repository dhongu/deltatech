<odoo>
    <record id="view_warehouse_form_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="purchase_stock.view_warehouse_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='buy_to_resupply']" position="after">
                <field name="generate_reorder_rules" />
            </xpath>
        </field>
    </record>
</odoo>
