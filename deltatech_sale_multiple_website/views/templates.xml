<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="product_qty_restrictions"
        inherit_id="website_sale.cta_wrapper"
        name="Product Quantity Restrictions"
    >
        <xpath expr="//div[@id='product_option_block']" position="after">
            <div
                t-attf-class="text-muted mt-2 #{'d-none' if not ((product.qty_multiple and product.qty_multiple &gt; 1) or (product.qty_minim and product.qty_minim &gt; 0)) else ''}"
                id="product_qty_restrictions"
            >
                <span
                    t-attf-class="me-3 qty-minimum-rule #{'d-none' if not (product.qty_minim and product.qty_minim &gt; 0) else ''}"
                >
                    <i class="oi me-1" data-icon="deployed_code" aria-hidden="true"/>
                    <span>
                        Min:
                        <span
                            class="qty-rule-value"
                            t-field="product.qty_minim"
                            t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                        />
                    </span>
                    <button
                        type="button"
                        class="btn btn-link border-0 p-0 ms-1 text-muted qty-info-popover"
                        data-bs-toggle="popover"
                        data-bs-trigger="focus"
                        data-bs-placement="top"
                        title="Minimum quantity"
                        aria-label="Minimum quantity"
                        t-attf-data-bs-content.translate="The minimum order quantity is #{product.qty_minim} units."
                    >
                        <i class="oi oi-filled" data-icon="info" aria-hidden="true"/>
                    </button>
                </span>
                <span
                    t-attf-class="qty-multiple-rule #{'d-none' if not (product.qty_multiple and product.qty_multiple &gt; 1) else ''}"
                >
                    <i class="oi me-1" data-icon="view_module" aria-hidden="true"/>
                    <span>
                        Multiple of:
                        <span
                            class="qty-rule-value"
                            t-field="product.qty_multiple"
                            t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                        />
                    </span>
                    <button
                        type="button"
                        class="btn btn-link border-0 p-0 ms-1 text-muted qty-info-popover"
                        data-bs-toggle="popover"
                        data-bs-trigger="focus"
                        data-bs-placement="top"
                        title="Quantity multiple"
                        aria-label="Quantity multiple"
                        t-attf-data-bs-content.translate="Quantity must be a multiple of #{product.qty_multiple} (e.g. #{product.qty_multiple}, #{product.qty_multiple * 2}, #{product.qty_multiple * 3}...)."
                    >
                        <i class="oi oi-filled" data-icon="info" aria-hidden="true"/>
                    </button>
                </span>
            </div>
        </xpath>
    </template>

    <template
        id="cart_line_description_following_lines"
        inherit_id="website_sale.cart_line_description_following_lines"
        name="Cart Product Quantity Restrictions"
    >
        <xpath expr="//div" position="after">
            <t
                t-set="sale_qty_rules"
                t-value="line.product_id.with_context(website_id=line.order_id.website_id.id)._get_sale_quantity_rules(line.product_uom_id)"
            />
            <div t-if="sale_qty_rules[0] or sale_qty_rules[1]" class="text-muted small">
                <t t-if="sale_qty_rules[0]">
                    <i class="oi me-1" data-icon="deployed_code" aria-hidden="true"/>
                    <span class="me-2">
                        Min:
                        <t
                            t-out="sale_qty_rules[0]"
                            t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                        />
                    </span>
                </t>
                <t t-if="sale_qty_rules[1]">
                    <i class="oi me-1" data-icon="view_module" aria-hidden="true"/>
                    <span t-translation="off">x</span><t
                        t-out="sale_qty_rules[1]"
                        t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                    />
                </t>
            </div>
        </xpath>
    </template>
</odoo>
